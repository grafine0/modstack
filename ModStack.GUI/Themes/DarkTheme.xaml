<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#23232C"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1C22"/>
    <SolidColorBrush x:Key="CardBrush" Color="#2D2E40"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8A8886"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#2D2E40"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#1A1A2E"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#006cfc"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0a5ecd"/>
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#006cfc"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#107C10"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF8C00"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D13438"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#006cfc"/>
    <Color x:Key="DropShadowColor">#000000</Color>
    <!-- Light Status Brushes for Dark Theme -->
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#1A3D1A"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#4A2A00"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#4A1A1A"/>
    <SolidColorBrush x:Key="InfoLightBrush" Color="#001A3D"/>

    <!-- Window -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#23232C"/>
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#3E3E42"/>

    <!-- Title Bar Colors -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#23232C"/>
    <SolidColorBrush x:Key="TitleBarTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarButtonBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#37353E"/>
    <SolidColorBrush x:Key="TitleBarButtonIconBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="TitleBarButtonIconHoverBrush" Color="#FFFFFF"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollThumbNormalBrush" Color="#555"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#999"/>
    <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#64B5F6"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="Transparent"/>

    <!-- Scrollbar Style -->
    <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}" HorizontalAlignment="Right" Width="6">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="20" MaxHeight="150">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBorder"
                                                    Width="6"
                                                    CornerRadius="3"
                                                    Background="{DynamicResource ScrollThumbNormalBrush}"
                                                    Opacity="0"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background"
                                                            Value="{DynamicResource ScrollThumbHoverBrush}"/>
                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background"
                                                            Value="{DynamicResource ScrollThumbDragBrush}"/>
                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apply scrollbar globally -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource ModernScrollBar}"/>

    <!-- ScrollViewer -->
    <Style x:Key="ModernScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- ComboBox -->
    <Style x:Key="ModernComboBoxDark" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Background -->
                        <Border x:Name="Border"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"/>

                        <!-- Selected Item -->
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                IsHitTestVisible="False"/>

                        <!-- Dropdown Arrow -->
                        <Path x:Name="Arrow"
                              Data="M0,0 L4,4 L8,0"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.5"
                              Margin="0,0,12,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"/>

                        <!-- Clickable Overlay -->
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox -->
    <Style x:Key="ModernTextBoxDark" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource BackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SearchBox -->
    <Style x:Key="SearchBoxDark" TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxDark}">
        <Setter Property="Padding" Value="12,8,40,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Border"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                            <!-- Search Icon -->
                            <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Width="16" Height="16"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Labels & Headings -->
    <Style x:Key="ModernLabelDark" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="ModernHeading3Dark" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- ToggleSwitch -->
    <Style x:Key="ModernToggleSwitchDark" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ToggleTrack"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Width="44" Height="24"
                                CornerRadius="12">
                            <Ellipse x:Name="ToggleThumb"
                                     Fill="{DynamicResource TextSecondaryBrush}"
                                     Width="20" Height="20"
                                     HorizontalAlignment="Left"
                                     Margin="2"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="ToggleThumb" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleTrack" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Modern DatePicker Dark Theme -->
    <Style x:Key="ModernDatePickerDark" TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="Border"
                            CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Date Text Button -->
                            <Button x:Name="PART_Button"
                                    Grid.Column="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Focusable="False">
                                <ContentPresenter Content="{TemplateBinding SelectedDate}"
                                                ContentStringFormat="MM/dd/yyyy"
                                                VerticalAlignment="Center"/>
                            </Button>
                            
                            <!-- Calendar Icon -->
                            <Button x:Name="PART_DropDownButton"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,0,8,0"
                                    Width="32"
                                    Focusable="False">
                                <Path Data="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"
                                      Fill="{DynamicResource TextSecondaryBrush}"
                                      Width="16"
                                      Height="16"
                                      Stretch="Uniform"/>
                            </Button>
                            
                            <!-- Popup for Calendar -->
                            <Popup x:Name="PART_Popup"
                                   PlacementTarget="{Binding ElementName=Border}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
