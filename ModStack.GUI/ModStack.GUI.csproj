<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app-icon.ico</ApplicationIcon>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>ModStack</Product>
    <Company>ModStack</Company>
    <Description>ModStack Local Development Environment Manager for Windows</Description>
    <Copyright>Copyright (c) 2026 ModStack</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModStack.Core\ModStack.Core.csproj" />
    <ProjectReference Include="..\ModStack.Services\ModStack.Services.csproj" />
    <ProjectReference Include="..\ModStack.Data\ModStack.Data.csproj" />
    <ProjectReference Include="..\ModStack.Common\ModStack.Common.csproj" />
    <ProjectReference Include="..\ModStack.Styles\ModStack.Styles.csproj" />
    <ProjectReference Include="..\ModStack.Logging\ModStack.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Microsoft.VisualBasic" Version="10.3.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2420.47" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Themes\LightTheme.xaml" />
    <Resource Include="Themes\DarkTheme.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app-icon.ico" />
    <Resource Include="Resources\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Main resource file with Generator for code generation -->
    <EmbeddedResource Include="Resources\Strings.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <!-- Culture-specific resource files - no Generator needed, they use the same resource class -->
    <EmbeddedResource Include="Resources\Strings.fr-FR.resx" />
    <EmbeddedResource Include="Resources\Strings.es-ES.resx" />
    <EmbeddedResource Include="Resources\Strings.ar-SA.resx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Services\SeedData\DefaultPackages.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
