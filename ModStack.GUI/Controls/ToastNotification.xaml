<UserControl x:Class="ModStack.GUI.Controls.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             MinWidth="400"
             MaxWidth="600"
             d:DesignWidth="500" d:DesignHeight="100">
    <Border x:Name="MainBorder"
            Background="{DynamicResource CardBrush}"
            BorderThickness="0"
            CornerRadius="8"
            Margin="0,0,0,12"
            MinWidth="400"
            MaxWidth="600"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource DropShadowColor}"
                            BlurRadius="20"
                            ShadowDepth="4"
                            Opacity="0.3"
                            Direction="270"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="0" Y="0"/>
        </Border.RenderTransform>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left accent bar -->
            <Border x:Name="AccentBar"
                    Grid.Column="0"
                    Width="4"
                    Background="{DynamicResource SuccessBrush}"
                    CornerRadius="4,0,0,4"/>

            <!-- Content -->
            <StackPanel Grid.Column="1"
                       Margin="16,12,12,12">
                <!-- Title with icon -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock x:Name="IconTextBlock"
                              Text="✓"
                              FontSize="16"
                              FontWeight="Bold"
                              Foreground="{DynamicResource SuccessBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleTextBlock"
                              Text="Success"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Message -->
                <TextBlock x:Name="MessageTextBlock"
                          Text="Operation completed successfully"
                          FontSize="13"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Close button -->
            <Button Grid.Column="2"
                   x:Name="CloseButton"
                   Width="32"
                   Height="32"
                   Margin="0,8,8,0"
                   VerticalAlignment="Top"
                   Background="Transparent"
                   BorderThickness="0"
                   Cursor="Hand"
                   Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                               CornerRadius="4">
                            <TextBlock Text="×"
                                     FontSize="18"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>

