<Window x:Class="ModStack.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:controls="clr-namespace:ModStack.GUI.Controls"
        xmlns:loc="clr-namespace:ModStack.GUI.Converters"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/app-icon.ico">

    <!-- Outer shadow -->
    <Border CornerRadius="8"
            Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.25"
                              BlurRadius="15"
                              ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/> <!-- Status bar -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/> <!-- Sidebar -->
                <ColumnDefinition Width="*"/> <!-- Main content -->
            </Grid.ColumnDefinitions>

            <!-- Lightweight Blur Overlay - Hidden by default -->
            <Border Name="BlurOverlay"
                    Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Grid.RowSpan="2"
                    Background="#80000000"
                    Visibility="Collapsed"
                    CornerRadius="8"
                    Panel.ZIndex="1000">
                <!-- Removed BlurEffect to prevent memory spike - using darker overlay instead -->
            </Border>

            <!-- Modern Navigation Sidebar - Full Height -->
            <Border Grid.Row="0" Grid.Column="0"
                   Background="{DynamicResource SurfaceBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,0,1,0"
                   CornerRadius="8,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Fixed Logo Section -->
                        <RowDefinition Height="*"/> <!-- Scrollable Navigation Menu -->
                    </Grid.RowDefinitions>
                    
                    <!-- Fixed Logo/Brand Section -->
                    <Border Grid.Row="0" 
                           Style="{DynamicResource ModernCard}" 
                           Margin="16,16,16,0"
                           BorderThickness="0,0,0,1" 
                           Padding="20,16">
                        <StackPanel>
                            <!-- Logo -->
                            <Image Width="32" Height="32" 
                                   Source="pack://application:,,,/Resources/logo.png"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"
                                   Stretch="Uniform"/>
                            <TextBlock Text="{loc:Localize AppName}" 
                                      FontSize="20" 
                                      FontWeight="Bold" 
                                      Foreground="{DynamicResource PrimaryBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="{loc:Localize AppSubtitle}" 
                                      FontSize="11" 
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      HorizontalAlignment="Center"
                                      Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Scrollable Navigation Menu -->
                    <ScrollViewer Grid.Row="1" 
                                 VerticalScrollBarVisibility="Auto" 
                                 Style="{DynamicResource ModernScrollViewer}"
                                 Margin="16,10,0,16">
                        <StackPanel>
                        
                        <!-- Dashboard Section -->
                        <Button Name="DashboardButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="{loc:Localize NavDashboard}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Packages Section -->
                        <TextBlock Text="{loc:Localize SectionPackages}" 
                                  Style="{DynamicResource ModernSectionHeader}"/>
                        
                        <Button Name="PackageManagerButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="PackageManager">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="{loc:Localize NavManagePackages}" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="CreatePackageButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="CreatePackage">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Localize NavAddPackage}" FontSize="14" />
                            </StackPanel>
                        </Button>

                        <!-- Services Section -->
                        <TextBlock Text="{loc:Localize SectionServices}" 
                                  Style="{DynamicResource ModernSectionHeader}"/>
                        
                        <Button Name="ServicesButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="Services">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0"/>
                                <TextBlock Text="{loc:Localize NavManageServices}" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="ServiceLogsButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="ServiceLogs">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Localize NavServiceLogs}" FontSize="14" />
                            </StackPanel>
                        </Button>

                        <!-- Stacks Section -->
                        <TextBlock Text="{loc:Localize SectionStacks}" 
                                  Style="{DynamicResource ModernSectionHeader}"/>
                        
                        <Button Name="StacksButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="Stacks">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📚" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Localize NavManageStacks}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        
                        <Button Name="CreateStackButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="CreateStack">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Localize NavCreateStack}" FontSize="14" />
                            </StackPanel>
                        </Button>

                        <!-- Projects Section -->
                        <TextBlock Text="{loc:Localize SectionProjects}" 
                                  Style="{DynamicResource ModernSectionHeader}"/>
                        
                        <Button Name="ProjectsButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="Projects">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗂️" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Localize NavManageProjects}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        
                        <Button Name="CreateProjectButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="CreateProject">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Localize NavCreateProject}" FontSize="14" />
                            </StackPanel>
                        </Button>

                        <!-- Tools Section -->
                        <TextBlock Text="{loc:Localize SectionTools}" 
                                  Style="{DynamicResource ModernSectionHeader}"/>
                        
                        <Button Name="ConfigEditorButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="ConfigEditor">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Localize NavConfigEditor}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        
                        <Button Name="HostsEditorButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="HostsEditor">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Localize NavHostsFileEditor}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        
                        <Button Name="MailCatcherButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="MailCatcher">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✉️" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="Mail Catcher" FontSize="14" />
                            </StackPanel>
                        </Button>

                        <!-- Settings Section -->
                        <TextBlock Text="{loc:Localize SectionSystem}" 
                                  Style="{DynamicResource ModernSectionHeader}"/>
                        
                        <Button Name="SettingsButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Localize NavSettings}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        
                        <Button Name="UpdatesButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="Updates">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="Updates" FontSize="14" />
                            </StackPanel>
                        </Button>
                        
                        <Button Name="AboutButton"
                               Style="{DynamicResource ModernNavigationButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="About">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ️" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="{loc:Localize NavAbout}" FontSize="14" />
                            </StackPanel>
                        </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Main Content Area with Title Bar -->
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/> <!-- Title bar -->
                    <RowDefinition Height="*"/> <!-- Content -->
                </Grid.RowDefinitions>
                
                <!-- Title bar -->
                <Border Background="{DynamicResource TitleBarBackgroundBrush}" 
                        Grid.Row="0" 
                        CornerRadius="0,8,0,0"
                        MouseLeftButtonDown="TitleBar_MouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="{loc:Localize AppTitle}"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBarTextBrush}"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{DynamicResource TitleBarButton}" Width="40" Height="40"
                                    ToolTip="{loc:Localize TooltipMinimize}" Click="MinimizeButton_Click">
                                <TextBlock Text="─" FontSize="14" />
                            </Button>
                            <Button Style="{DynamicResource TitleBarButton}" Width="40" Height="40"
                                    ToolTip="{loc:Localize TooltipMaximize}" Click="Maximize_Click">
                                <TextBlock Text="☐" FontSize="12" />
                            </Button>
                            <Button Style="{DynamicResource CloseButton}" Width="40" Height="40"
                                    ToolTip="{loc:Localize TooltipClose}" Click="Close_Click">
                                <TextBlock Text="×" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content Panel -->
                <ContentControl Name="MainContentFrame" 
                      Grid.Row="1" 
                      Content="{Binding CurrentView}"
                      Margin="16"/>
            </Grid>

            <!-- Modern Status Bar -->
            <Border Grid.Row="1" Grid.ColumnSpan="2"
                   Background="{DynamicResource SurfaceBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0"
                   CornerRadius="0,0,8,8"
                   Height="40">
                
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Name="StatusText" 
                              Grid.Column="0"
                              Text="{Binding StatusText}"
                              VerticalAlignment="Center"/>
                    
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- Removed LogsButton_Click as it's non-standard. Should be a command or removed since it navigates to logs. Let's just use the navigation command. -->
                        <Button Name="LogsButton"
                               Style="{DynamicResource ModernSecondaryButton}"
                               Command="{Binding NavigateCommand}" CommandParameter="ServiceLogs"
                               Height="32"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="11" Margin="0,0,4,0"/>
                                <TextBlock Text="{loc:Localize ButtonLogs}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        
                        <TextBlock x:Name="VersionTextBlock"
                                  Text="v1.0.0" 
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource TextTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Notification Container (Overlay) - Spans Entire Window -->
            <controls:NotificationContainer x:Name="NotificationContainer" 
                                          Grid.ColumnSpan="2"
                                          Grid.RowSpan="2"
                                          Panel.ZIndex="9999"/>
        </Grid>
    </Border>
</Window>