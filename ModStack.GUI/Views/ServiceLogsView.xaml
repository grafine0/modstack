<UserControl x:Class="ModStack.GUI.Views.ServiceLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:loc="clr-namespace:ModStack.GUI.Converters">
    
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <StackPanel Margin="20">
                <TextBlock Text="{loc:Localize ServiceLogsTitle}" Style="{StaticResource ModernHeading1}" Margin="0,0,0,8"/>
                <TextBlock Text="{loc:Localize ServiceLogsDescription}" Style="{StaticResource ModernCaptionText}"/>
                
                <!-- Search and Filter Bar -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/> <!-- Search wider -->
                        <ColumnDefinition Width="1*"/> <!-- Log Level Filter -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Search Box -->
                    <TextBox Name="SearchTextBox"
                            Grid.Column="0"
                            Style="{StaticResource SearchBox}"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,12,0"
                            TextChanged="SearchTextBox_TextChanged"/>
                    
                    <!-- Log Level Filter -->
                    <ComboBox Name="LogLevelFilterComboBox"
                            Grid.Column="1"
                            Style="{StaticResource ModernComboBox}"
                            Height="40"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="LogLevelFilterComboBox_SelectionChanged">
                        <ComboBoxItem Content="{loc:Localize LogLevelAll}" IsSelected="True"/>
                        <ComboBoxItem Content="{loc:Localize LogLevelInfo}"/>
                        <ComboBoxItem Content="{loc:Localize LogLevelWarning}"/>
                        <ComboBoxItem Content="{loc:Localize LogLevelError}"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Log Display -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Name="LogPanel" Margin="20"/>
            </ScrollViewer>
        </Border>
        
        <!-- Controls -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left side buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Name="RefreshButton" Content="{loc:Localize ButtonRefresh}" Style="{StaticResource ModernPrimaryButton}" 
                            Click="RefreshButton_Click" Margin="0,0,12,0"/>
                    <Button Name="ClearButton" Content="{loc:Localize ButtonClear}" Style="{StaticResource ModernSecondaryButton}" 
                            Click="ClearButton_Click" Margin="0,0,12,0"/>
                    <Button Name="SaveButton" Content="{loc:Localize ButtonSaveLogs}" Style="{StaticResource ModernSecondaryButton}" 
                            Click="SaveButton_Click" Margin="0,0,12,0"/>
                    <Button Name="CopyAllButton" Content="{loc:Localize ButtonCopyAllLogs}" Style="{StaticResource ModernSecondaryButton}" 
                            Click="CopyAllButton_Click" Margin="0,0,12,0"/>
                    <Grid VerticalAlignment="Center" Margin="12,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Text="{loc:Localize AutoScroll}"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Margin="0,0,10,0"/>
                        <CheckBox Name="AutoScrollCheckBox"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernToggleSwitch}"
                                  HorizontalAlignment="Left"
                                  Margin="12,0,0,0"
                                  FontSize="14"
                                  Foreground="#333333"
                                  IsChecked="True"/>
                    </Grid>
                </StackPanel>
                
                <!-- Right side log count -->
                <TextBlock Name="LogCountTextBlock" 
                           Grid.Column="1"
                           Text="" 
                           Style="{StaticResource ModernCaptionText}" 
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>