<UserControl x:Class="ModStack.GUI.Views.Controls.SuccessOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    
    <Grid x:Name="OverlayGrid" 
          Style="{StaticResource SuccessOverlayTemplate}"
          HorizontalAlignment="Stretch" 
          VerticalAlignment="Stretch"
          Width="300"
          Height="200">
        
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="280"
                MinHeight="160">
            
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center">
                
                <!-- Loading Spinner -->
                <Border x:Name="OverlayLoadingSpinner" 
                        Style="{StaticResource LoadingSpinnerTemplate}">
                    <Ellipse Width="8" Height="8" 
                             Fill="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Margin="2"/>
                </Border>
                
                <!-- Success Icon -->
                <TextBlock x:Name="OverlaySuccessIcon" 
                           Style="{StaticResource SuccessIconTemplate}"/>
                
                <!-- Progress Text -->
                <TextBlock x:Name="OverlayProgressText" 
                           Style="{StaticResource ProgressTextTemplate}"
                           Text="Processing..."/>
                
                <!-- Subtitle Text -->
                <TextBlock x:Name="OverlaySubtitleText" 
                           Style="{StaticResource SubtitleTextTemplate}"
                           Text="Please wait while we complete this operation..."/>
                
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
