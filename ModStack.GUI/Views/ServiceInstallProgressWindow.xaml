<Window x:Class="ModStack.GUI.Views.ServiceInstallProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ModStack.GUI.Converters"
        Title="{Binding Title}" 
        Height="320" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <converters:ProgressToWidthConverter x:Key="ProgressToWidthConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </Window.Resources>
    
    <!-- Modern dialog container with shadow -->
    <Border CornerRadius="12"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.3"
                              BlurRadius="20"
                              ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Title bar -->
                <RowDefinition Height="*"/>     <!-- Content -->
                <RowDefinition Height="Auto"/>  <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Modern Title Bar -->
            <Border Grid.Row="0" Style="{StaticResource DialogTitleBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Operation Icon -->
                    <TextBlock Grid.Column="0"
                              Text="{Binding OperationIcon}"
                              FontSize="20"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                    
                    <!-- Title with Download Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DownloadInfo}"
                                  FontSize="12"
                                  FontWeight="Normal"
                                  Foreground="{DynamicResource AccentBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,2,0,0"
                                  Visibility="{Binding DownloadInfo, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="2"
                           Style="{StaticResource DialogCloseButtonStyle}"
                           Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1" Margin="32,24,32,24">
        <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Progress info -->
                    <RowDefinition Height="Auto"/>  <!-- Progress bar -->
                    <RowDefinition Height="Auto"/>  <!-- Speed/ETA info -->
                    <RowDefinition Height="*"/>     <!-- Spacer -->
        </Grid.RowDefinitions>
        
                <!-- Progress Information -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                              Text="{Binding StatusText}"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"/>
                    
                    <TextBlock Grid.Column="1"
                              Text="{Binding Progress, StringFormat={}{0:F0}%}"
                              FontSize="14"
                              FontWeight="Bold"
                              Foreground="{DynamicResource AccentBrush}"
                              VerticalAlignment="Center"/>
                </Grid>
                
                <!-- Modern Progress Bar (Custom Implementation with Animation) -->
                <!-- Alternative: Use WPF ProgressBar for simpler binding (uncomment to use):
                <ProgressBar Grid.Row="2"
                             Height="8"
                             Value="{Binding Progress}"
                             Maximum="100"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="#40FFFFFF"
                             Margin="0,0,0,16"
                             Style="{x:Null}"/>
                -->
                
                <Border Grid.Row="1"
                       x:Name="ProgressTrack"
                       Background="{DynamicResource BorderBrush}"
                       CornerRadius="8"
                       Height="10"
                       Margin="0,0,0,16"
                       ClipToBounds="True">
                    <Border x:Name="ProgressIndicator"
                           Background="{DynamicResource AccentBrush}"
                           CornerRadius="8"
                           HorizontalAlignment="Left">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource ProgressToWidthConverter}" NotifyOnTargetUpdated="True">
                                <Binding Path="Progress"/>
                                <Binding ElementName="ProgressTrack" Path="ActualWidth"/>
                            </MultiBinding>
                        </Border.Width>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                                       Duration="0:0:0.3"
                                                       FillBehavior="Stop">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                    </Border>
                </Border>
                
                <!-- Speed and ETA Information -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0"
                              Text="{Binding DownloadSpeed}"
                              FontSize="12"
                              FontWeight="Medium"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"/>
                    
                    <TextBlock Grid.Column="1"
                              Text="{Binding ETA}"
                              FontSize="12"
                              FontWeight="Medium"
                              Foreground="{DynamicResource AccentBrush}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Button Area -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right">
                    
                    <!-- Cancel Button -->
                    <Button x:Name="CancelButton"
                           Content="Cancel"
                           MinWidth="100"
                           Height="36"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Cursor="Hand"
                           Click="CancelButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource SecondaryButtonBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                   BorderBrush="{TemplateBinding BorderBrush}"
                                                   BorderThickness="{TemplateBinding BorderThickness}"
                                                   CornerRadius="6"
                                                   Padding="16,8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
    </Grid>
    </Border>
</Window>
