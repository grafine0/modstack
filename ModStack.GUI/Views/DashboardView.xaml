<UserControl x:Class="ModStack.GUI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019">

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <!-- Main Content -->
        <ScrollViewer Name="MainContent" VerticalScrollBarVisibility="Auto" Background="{DynamicResource BackgroundBrush}">
            <StackPanel Margin="24">
            
            <!-- Modern Welcome Header -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Text="Dashboard" 
                              Style="{StaticResource ModernHeading1}"
                              Margin="0,0,0,8"/>
                    <TextBlock Text="Monitor your development environment and manage services" 
                              Style="{StaticResource ModernCaptionText}"
                              FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- Modern Stats Cards -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Total Services Card -->
                <Border Grid.Column="0" 
                       Style="{StaticResource ModernCard}"
                       Margin="0,0,12,0"
                       Padding="20">
                    <StackPanel>
                        <Border Background="{StaticResource SuccessBrush}" 
                               CornerRadius="20" 
                               Width="40" Height="40"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12">
                            <TextBlock Text="⚡" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding TotalServicesCount}" 
                                  FontSize="28" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Services" 
                                  Style="{StaticResource ModernCaptionText}"
                                  HorizontalAlignment="Center"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Stacks Card -->
                <Border Grid.Column="1" 
                       Style="{StaticResource ModernCard}"
                       Margin="6,0"
                       Padding="20">
                    <StackPanel>
                        <Border Background="{StaticResource PrimaryBrush}" 
                               CornerRadius="20" 
                               Width="40" Height="40"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12">
                            <TextBlock Text="📚" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding TotalStacksCount}" 
                                  FontSize="28" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Stacks" 
                                  Style="{StaticResource ModernCaptionText}"
                                  HorizontalAlignment="Center"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Projects Card -->
                <Border Grid.Column="2" 
                       Style="{StaticResource ModernCard}"
                       Margin="6,0"
                       Padding="20">
                    <StackPanel>
                        <Border Background="{StaticResource WarningBrush}" 
                               CornerRadius="20" 
                               Width="40" Height="40"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12">
                            <TextBlock Text="📁" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding ProjectsCount}" 
                                  FontSize="28" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Projects" 
                                  Style="{StaticResource ModernCaptionText}"
                                  HorizontalAlignment="Center"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- Total Packages Card -->
                <Border Grid.Column="3" 
                       Style="{StaticResource ModernCard}"
                       Margin="12,0,0,0"
                       Padding="20">
                    <StackPanel>
                        <Border Background="{StaticResource InfoBrush}" 
                               CornerRadius="20" 
                               Width="40" Height="40"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12">
                            <TextBlock Text="📦" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding TotalPackagesCount}" 
                                  FontSize="28" 
                                  FontWeight="Bold"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Total Packages" 
                                  Style="{StaticResource ModernCaptionText}"
                                  HorizontalAlignment="Center"
                                  Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Modern Quick Actions -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Active Stack Control -->
                <Border Grid.Column="0" 
                        Style="{StaticResource ModernCard}"
                        Margin="0,0,12,0"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="🎯 Active Stack Control" 
                                  Style="{StaticResource ModernHeading2}"
                                  Margin="0,0,0,16"/>
                        
                        <ComboBox Name="DashboardStackComboBox" 
                                 Style="{StaticResource ModernComboBox}"
                                 DisplayMemberPath="DisplayName"
                                 ItemsSource="{Binding AvailableStacks}"
                                 SelectedItem="{Binding SelectedStack}"
                                 Margin="0,0,0,16"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Name="StartStackButton"
                                   Grid.Column="0"
                                   Style="{StaticResource ModernPrimaryButton}"
                                   Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶️" Margin="0,0,6,0"/>
                                    <TextBlock Text="Start"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Name="StopStackButton"
                                   Grid.Column="1"
                                   Style="{StaticResource ModernSecondaryButton}"
                                   Margin="3,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏹️" Margin="0,0,6,0"/>
                                    <TextBlock Text="Stop"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Name="RestartStackButton"
                                   Grid.Column="2"
                                   Style="{StaticResource ModernSecondaryButton}"
                                   Margin="6,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" Margin="0,0,6,0"/>
                                    <TextBlock Text="Restart"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Quick Launch -->
                <Border Grid.Column="1" 
                        Style="{StaticResource ModernCard}"
                        Margin="12,0,0,0"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="🚀 Quick Launch" 
                                  Style="{StaticResource ModernHeading2}"
                                  Margin="0,0,0,16"/>
                        
                        <Button Name="CreateNewStackButton"
                               Style="{StaticResource ModernPrimaryButton}"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" Margin="0,0,8,0"/>
                                <TextBlock Text="Create New Stack"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="CreateNewProjectButton"
                               Style="{StaticResource ModernSecondaryButton}"
                               HorizontalAlignment="Stretch"
                               Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗂️" Margin="0,0,8,0"/>
                                <TextBlock Text="Create New Project"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Modern Service Status Overview -->
            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Text="⚙️ Service Status Overview" 
                              Style="{StaticResource ModernHeading2}"
                              Margin="0,0,0,16"/>
                    
                    <Grid MaxHeight="300">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" 
                                Background="{DynamicResource BackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="8,8,0,0"
                                Padding="20,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="200"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" 
                                          Text="Service" 
                                          FontWeight="Bold" 
                                          FontSize="14" 
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>

                                <TextBlock Grid.Column="1" 
                                          Text="Status" 
                                          FontWeight="Bold" 
                                          FontSize="14" 
                                          Foreground="{DynamicResource TextPrimaryBrush}" 
                                          HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="2" 
                                          Text="Port" 
                                          FontWeight="Bold" 
                                          FontSize="14" 
                                          Foreground="{DynamicResource TextPrimaryBrush}" 
                                          HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="3" 
                                          Text="Version" 
                                          FontWeight="Bold" 
                                          FontSize="14" 
                                          Foreground="{DynamicResource TextPrimaryBrush}" 
                                          HorizontalAlignment="Center"/>

                                <TextBlock Grid.Column="4" 
                                          Text="Actions" 
                                          FontWeight="Bold" 
                                          FontSize="14" 
                                          Foreground="{DynamicResource TextPrimaryBrush}" 
                                          HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Services List -->
                        <ScrollViewer Grid.Row="1" 
                                      VerticalScrollBarVisibility="Auto" 
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl Name="ServiceStatusGrid" 
                                        ItemsSource="{Binding Services}"
                                        Margin="0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BackgroundBrush}" 
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                BorderThickness="0,0,0,1" 
                                                Padding="20,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Service Info -->
                                                <StackPanel Grid.Column="0" 
                                                           Orientation="Horizontal" 
                                                           VerticalAlignment="Center">
                                                    <Ellipse Width="12" Height="12" 
                                                            Fill="#2196F3"
                                                            Margin="0,0,12,0"
                                                            VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" 
                                                                  FontSize="14" 
                                                                  FontWeight="SemiBold" 
                                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Version}" 
                                                                  FontSize="12" 
                                                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Status -->
                                                <StackPanel Grid.Column="1" 
                                                           Orientation="Vertical" 
                                                           VerticalAlignment="Center" 
                                                           Margin="16,0,0,0">
                                                    <Ellipse Width="10" Height="10" 
                                                            Fill="{Binding Status, Converter={StaticResource StatusToBrushConverter}}"
                                                            Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Status}" 
                                                              FontSize="11" 
                                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                                              HorizontalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Port -->
                                                <TextBlock Grid.Column="2" 
                                                          Text="{Binding Port}" 
                                                          FontSize="12" 
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          VerticalAlignment="Center" 
                                                          Margin="16,0,0,0"
                                                          HorizontalAlignment="Center"/>

                                                <!-- Version -->
                                                <TextBlock Grid.Column="3" 
                                                          Text="{Binding Version}" 
                                                          FontSize="12" 
                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                          VerticalAlignment="Center" 
                                                          Margin="16,0,0,0"
                                                          HorizontalAlignment="Center"/>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="4" 
                                                           Orientation="Horizontal" 
                                                           VerticalAlignment="Center" 
                                                           HorizontalAlignment="Center"
                                                           Margin="16,0,0,0">
                                                    <Button Style="{StaticResource TitleBarButton}"
                                                           Width="32" Height="32"
                                                           Margin="0,0,8,0"
                                                           IsEnabled="{Binding CanStart}"
                                                           Click="StartService_Click"
                                                           ToolTip="Start service">
                                                        <TextBlock Text="▶️" FontSize="12"/>
                                                    </Button>
                                                    <Button Style="{StaticResource TitleBarButton}"
                                                           Width="32" Height="32"
                                                           Margin="0,0,8,0"
                                                           IsEnabled="{Binding CanStop}"
                                                           Click="StopService_Click"
                                                           ToolTip="Stop service">
                                                        <TextBlock Text="⏹️" FontSize="12"/>
                                                    </Button>
                                                    <Button Style="{StaticResource TitleBarButton}"
                                                           Width="32" Height="32"
                                                           Click="ConfigureService_Click"
                                                           ToolTip="Configure service">
                                                        <TextBlock Text="⚙️" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Name="LoadingOverlay" 
                Background="{DynamicResource BackgroundBrush}"
                Panel.ZIndex="1000"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Animated Loading Spinner -->
                    <Border Width="48" Height="48" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="CornerRadius" Value="24"/>
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                               From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <RotateTransform CenterX="24" CenterY="24"/>
                        </Border.RenderTransform>
                        <Ellipse Width="8" Height="8" 
                                 Fill="{DynamicResource PrimaryBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="2"/>
                    </Border>
                    
                    <TextBlock Text="Loading Dashboard..." 
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="18"
                              FontWeight="SemiBold"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,8"/>
                    <TextBlock Text="Initializing services and data..." 
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="14"
                              HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
