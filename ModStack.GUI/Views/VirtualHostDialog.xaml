<Window x:Class="ModStack.GUI.Views.VirtualHostDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Virtual Host Configuration" 
        Height="680" 
        Width="780"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <!-- Outer shadow -->
    <Border CornerRadius="8"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.25"
                              BlurRadius="15"
                              ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Style="{StaticResource DialogTitleBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DialogTitle}" 
                                   Style="{StaticResource DialogTitleTextStyle}"/>
                        <TextBlock Text="{Binding DialogDescription}"
                                   Style="{StaticResource DialogSubtitleTextStyle}"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" 
                            Style="{StaticResource DialogCloseButtonStyle}"
                            Click="CloseButton_Click"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
                <StackPanel>
                    <!-- Basic Configuration -->
                    <Border Grid.Row="0" 
                        Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Basic Configuration" 
                                    FontSize="18" 
                                    FontWeight="SemiBold" 
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Server Name Label -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                        Text="Server Name *"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,8"/>

                                <!-- Port Label -->
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                        Text="Port *"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,8"/>

                                <!-- Server Name -->
                                <TextBox Grid.Row="1" Grid.Column="0"
                                        Style="{StaticResource ModernTextBox}"
                                        Text="{Binding ServerName}"
                                        Margin="0,0,8,16"/>

                                <!-- Port -->
                                <TextBox Grid.Row="1" Grid.Column="1"
                                        Style="{StaticResource ModernTextBox}"
                                        Text="{Binding Port}"
                                        Margin="8,0,0,16"/>

                                <!-- Server Alias Label -->
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                        Text="Server Alias (Optional)"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,8"/>

                                <!-- Service Label -->
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                        Text="Web Service *"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,8"/>

                                <!-- Server Alias -->
                                <TextBox Grid.Row="3" Grid.Column="0"
                                        Style="{StaticResource ModernTextBox}"
                                        Text="{Binding ServerAlias}"
                                        Margin="0,0,8,16"/>

                                <!-- Service -->
                                <ComboBox Grid.Row="3" Grid.Column="1"
                                        Style="{StaticResource ModernComboBox}"
                                        ItemsSource="{Binding AvailableServices}"
                                        SelectedItem="{Binding SelectedService}"
                                        DisplayMemberPath="DisplayName"
                                        Margin="8,0,0,16"/>

                                <!-- Document Root Label -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                        Text="Document Root Path *"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,8"/>

                                <!-- Document Root with Browse Button -->
                                <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox Grid.Column="0"
                                            Style="{StaticResource ModernTextBox}"
                                            Text="{Binding DocumentRoot}"
                                            Margin="0,0,8,0"/>
                                    
                                    <Button Grid.Column="1"
                                            Content="Browse..."
                                            Click="BrowseDocumentRoot_Click"
                                            Style="{StaticResource ModernPrimaryButton}"
                                            Padding="16,8"
                                            FontSize="12"/>
                                </Grid>
                            </Grid>

                            <!-- Project Association Section -->
                            <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20" 
                            Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Project Association" 
                                            FontSize="16" 
                                            FontWeight="SemiBold" 
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Margin="0,0,0,16"/>

                                    <TextBlock Text="Associated Project (Optional)"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Margin="0,0,0,8"/>

                                    <ComboBox Style="{StaticResource ModernComboBox}"
                                            ItemsSource="{Binding AvailableProjects}"
                                            SelectedItem="{Binding SelectedProject}"
                                            DisplayMemberPath="Name"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SSL Configuration -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20" 
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="SSL Configuration" 
                                    FontSize="18" 
                                    FontWeight="SemiBold" 
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Margin="0,0,0,16"/>

                            <StackPanel>
                                <!-- Enable SSL Toggle -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="Enable SSL/HTTPS"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            HorizontalAlignment="Left"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Margin="0,0,10,0"/>
                                    <CheckBox Grid.Column="1"
                                            Style="{StaticResource ModernToggleSwitch}"
                                            HorizontalAlignment="Left"
                                            Margin="12,0,0,0"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            IsChecked="{Binding IsSSL}"/>
                                </Grid>

                                <!-- SSL Certificate Path Label -->
                                <TextBlock Text="SSL Certificate File Path *"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,8"
                                        IsEnabled="{Binding IsSSL}"/>

                                <!-- SSL Certificate Path with Browse Button -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox Grid.Column="0"
                                            Style="{StaticResource ModernTextBox}"
                                            Text="{Binding SSLCertPath}"
                                            Margin="0,0,8,0"
                                            IsEnabled="{Binding IsSSL}"/>
                                    
                                    <Button Grid.Column="1"
                                            Content="Browse..."
                                            Click="BrowseSSLCertPath_Click"
                                            Style="{StaticResource ModernPrimaryButton}"
                                            Padding="16,8"
                                            FontSize="12"
                                            IsEnabled="{Binding IsSSL}"/>
                                </Grid>

                                <!-- SSL Key Path Label -->
                                <TextBlock Text="SSL Private Key File Path *"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,8"
                                        IsEnabled="{Binding IsSSL}"/>

                                <!-- SSL Key Path with Browse Button -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox Grid.Column="0"
                                            Style="{StaticResource ModernTextBox}"
                                            Text="{Binding SSLKeyPath}"
                                            Margin="0,0,8,0"
                                            IsEnabled="{Binding IsSSL}"/>
                                    
                                    <Button Grid.Column="1"
                                            Content="Browse..."
                                            Click="BrowseSSLKeyPath_Click"
                                            Style="{StaticResource ModernPrimaryButton}"
                                            Padding="16,8"
                                            FontSize="12"
                                            IsEnabled="{Binding IsSSL}"/>
                                </Grid>

                                <!-- SSL Info -->
                                <TextBlock Text="SSL certificates will be automatically configured. HTTP traffic will be redirected to HTTPS when SSL is enabled."
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Margin="0,16,0,0"
                                        IsEnabled="{Binding IsSSL}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Advanced Configuration -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20" 
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Advanced Configuration" 
                                    FontSize="18" 
                                    FontWeight="SemiBold" 
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Margin="0,0,0,16"/>

                            <StackPanel>
                                <!-- Enable Virtual Host Toggle -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="Enable Virtual Host"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            Margin="0,0,10,0"/>
                                    <CheckBox Grid.Column="1"
                                            Style="{StaticResource ModernToggleSwitch}"
                                            HorizontalAlignment="Left"
                                            Margin="12,0,0,0"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            IsChecked="{Binding IsVirtualHostEnabled}"/>
                                </Grid>

                                <!-- Additional Configuration Label -->
                                <TextBlock Text="Additional Configuration (Optional)"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,8"/>

                                <!-- Additional Configuration -->
                                <TextBox Style="{StaticResource ModernTextBox}"
                                        Text="{Binding AdditionalConfiguration}"
                                        AcceptsReturn="True"
                                        TextWrapping="Wrap"
                                        Height="100"
                                        VerticalScrollBarVisibility="Auto"/>

                                <!-- Configuration Info -->
                                <TextBlock Text="Add custom Apache/Nginx directives here. These will be appended to the generated configuration."
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        TextWrapping="Wrap"
                                        Margin="0,8,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <!-- Buttons -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Style="{StaticResource ModernSecondaryButton}"
                            Margin="0,0,12,0"
                            Width="100"
                            Click="CancelButton_Click"/>
                    <Button x:Name="SaveButton"
                            Content="Create Virtual Host"
                            Style="{StaticResource ModernPrimaryButton}"
                            Width="120"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
