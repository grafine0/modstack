<UserControl x:Class="ModStack.GUI.Views.ExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:converters="clr-namespace:ModStack.GUI.Converters"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20" 
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PHP Extensions" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Manage PHP extensions for your projects" 
                               FontSize="14" 
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                
                <!-- Back Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource ModernSecondaryButton}"
                        Width="140"
                        Height="40"
                        Margin="0,0,20,0"
                        Click="BackButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" Margin="0,0,8,0"/>
                        <TextBlock Text="Back to Projects"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center">
                    <Button Name="RefreshButton"
                            Style="{StaticResource ModernSecondaryButton}"
                            Width="140"
                            Height="40"
                            Margin="0,0,12,0"
                            Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,8,0"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters Section -->
        <Border Grid.Row="1" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20,16" 
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Modern Search Box -->
                <TextBox x:Name="SearchTextBox" 
                        Grid.Column="0"
                        Style="{StaticResource SearchBox}"
                        Height="40"
                        Margin="0,0,12,0"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                </TextBox>

                <!-- Category Filter -->
                <ComboBox x:Name="CategoryComboBox"
                        Grid.Column="1"
                        Style="{StaticResource ModernComboBox}"
                        Height="40"
                        Width="140"
                        Margin="0,0,12,0"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}">
                </ComboBox>

                <!-- Status Filter -->
                <ComboBox x:Name="StatusComboBox"
                        Grid.Column="2"
                        Style="{StaticResource ModernComboBox}"
                        Height="40"
                        Width="140"
                        ItemsSource="{Binding StatusOptions}"
                        SelectedItem="{Binding SelectedStatus}">
                </ComboBox>
            </Grid>
        </Border>

        <!-- Extensions Table -->
        <Border Grid.Row="2" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8"
                Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="8,8,0,0" 
                        Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="Extension" 
                                  FontWeight="Bold" 
                                  FontSize="14" 
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Grid.Column="1" 
                                  Text="Status" 
                                  FontWeight="Bold" 
                                  FontSize="14" 
                                  Foreground="{DynamicResource TextPrimaryBrush}" 
                                  HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="2" 
                                  Text="Category" 
                                  FontWeight="Bold" 
                                  FontSize="14" 
                                  Foreground="{DynamicResource TextPrimaryBrush}" 
                                  HorizontalAlignment="Center"/>

                        <TextBlock Grid.Column="3" 
                                  Text="Actions" 
                                  FontWeight="Bold" 
                                  FontSize="14" 
                                  Foreground="{DynamicResource TextPrimaryBrush}" 
                                  HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Extensions List -->
                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl Name="ExtensionsDataGrid" 
                                ItemsSource="{Binding Extensions}"
                                Margin="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBrush}" 
                                        BorderBrush="{DynamicResource BorderBrush}" 
                                        BorderThickness="0,0,0,1" 
                                        Padding="20,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Extension Info -->
                                        <StackPanel Grid.Column="0" 
                                                   Orientation="Horizontal" 
                                                   VerticalAlignment="Center">
                                            <Ellipse Width="12" Height="12" 
                                                    Fill="{DynamicResource PrimaryBrush}"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Name}" 
                                                              FontSize="14" 
                                                              FontWeight="SemiBold" 
                                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                                              Margin="0,0,8,0"/>
                                                    
                                                    <!-- Popular Badge -->
                                                    <Border Background="{DynamicResource AccentBrush}" 
                                                           CornerRadius="8" 
                                                           Padding="4,2" 
                                                           Margin="0,0,4,0"
                                                           Visibility="{Binding IsPopular, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="POPULAR" 
                                                                  Foreground="White" 
                                                                  FontSize="8" 
                                                                  FontWeight="Bold"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <!-- Built-in Badge -->
                                                    <Border Background="{DynamicResource InfoBrush}" 
                                                           CornerRadius="8" 
                                                           Padding="4,2" 
                                                           Margin="0,0,4,0"
                                                           Visibility="{Binding IsBuiltIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="BUILT-IN" 
                                                                  Foreground="White" 
                                                                  FontSize="8" 
                                                                  FontWeight="Bold"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <!-- Installed Badge -->
                                                    <Border Background="{DynamicResource SuccessBrush}" 
                                                           CornerRadius="8" 
                                                           Padding="4,2" 
                                                           Margin="0,0,4,0"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="INSTALLED" 
                                                                  Foreground="White" 
                                                                  FontSize="8" 
                                                                  FontWeight="Bold"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" 
                                                          FontSize="12" 
                                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                                          TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Status -->
                                        <StackPanel Grid.Column="1" 
                                                   Orientation="Vertical" 
                                                   VerticalAlignment="Center" 
                                                   Margin="16,0,0,0">
                                            <Ellipse Width="10" Height="10" 
                                                    Fill="{Binding IsEnabled, Converter={StaticResource BooleanToColorConverter}}"
                                                    Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding StatusText}" 
                                                      FontSize="11" 
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Category -->
                                        <TextBlock Grid.Column="2" 
                                                  Text="{Binding Category}" 
                                                  FontSize="12" 
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  VerticalAlignment="Center" 
                                                  Margin="16,0,0,0"
                                                  HorizontalAlignment="Center"/>

                                        <!-- Actions -->
                                        <StackPanel Grid.Column="3" 
                                                   Orientation="Horizontal" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center"
                                                   Margin="0">
                                            
                                            <!-- Install Button -->
                                            <Button Style="{StaticResource TitleBarButton}"
                                                   Width="32" Height="32"
                                                   Margin="0,0,8,0"
                                                   Click="InstallButton_Click"
                                                   Tag="{Binding}"
                                                   ToolTip="Install Extension"
                                                   IsEnabled="{Binding IsInstalled, Converter={StaticResource InverseBooleanConverter}}">
                                                <TextBlock Text="↓" FontSize="14"/>
                                            </Button>
                                            
                                            <!-- Enable/Disable Button -->
                                            <Button Style="{StaticResource TitleBarButton}"
                                                   Width="32" Height="32"
                                                   Margin="0,0,8,0"
                                                   Click="ToggleButton_Click"
                                                   Tag="{Binding}"
                                                   ToolTip="{Binding ToggleButtonText}"
                                                   IsEnabled="{Binding IsInstalled}">
                                                <TextBlock Text="{Binding ToggleButtonIcon}" FontSize="12"/>
                                            </Button>
                                            
                                            <!-- Remove Button -->
                                            <Button Style="{StaticResource TitleBarButton}"
                                                   Width="32" Height="32"
                                                   Margin="0,0,8,0"
                                                   Click="RemoveButton_Click"
                                                   Tag="{Binding}"
                                                   ToolTip="Remove Extension"
                                                   IsEnabled="{Binding IsInstalled}">
                                                <TextBlock Text="🗑️" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="3" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" 
                          Text="{Binding StatusMessage}" 
                          FontSize="12" 
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="1" 
                          Text="{Binding EntryCountText}" 
                          FontSize="12" 
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>