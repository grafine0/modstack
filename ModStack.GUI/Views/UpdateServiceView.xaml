<UserControl x:Class="ModStack.GUI.Views.UpdateServiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ModStack.GUI.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20" 
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Update Service Configuration" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Service.Name}" 
                               FontSize="14" 
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                
                <!-- Back Button -->
                <Button Grid.Column="1" 
                        Style="{StaticResource ModernSecondaryButton}"
                        Height="40"
                        Command="{Binding CancelCommand}"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="←" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Back to Services" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content with Tabs -->
        <Grid Grid.Row="1">
            <!-- Tab Control (shown when there are multiple tabs) -->
            <TabControl x:Name="TabControl"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                     SelectionChanged="TabControl_SelectionChanged"
                     Visibility="{Binding ShowTabControl, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" 
                                               Background="White"
                                               BorderBrush="{DynamicResource BorderBrush}"
                                               BorderThickness="0,0,1,0"
                                               Padding="20,12"
                                               Cursor="Hand">
                                            <ContentPresenter ContentSource="Header"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" 
                                                       Property="Background" 
                                                       Value="White"/>
                                                <Setter TargetName="Border" 
                                                       Property="BorderThickness" 
                                                       Value="0,0,0,2"/>
                                                <Setter TargetName="Border" 
                                                       Property="BorderBrush" 
                                                       Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Border" 
                                                       Property="Cursor" 
                                                       Value="Arrow"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="False"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Border" 
                                                       Property="Background" 
                                                       Value="#F5F5F5"/>
                                                <Setter TargetName="Border" 
                                                       Property="Cursor" 
                                                       Value="Hand"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- Configuration Tab -->
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock Text="Configuration" 
                                      FontSize="14" 
                                      FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                     HorizontalScrollBarVisibility="Disabled"
                                     Style="{StaticResource ModernScrollViewer}">
                            <StackPanel Margin="24">
                                <!-- Service Information Card -->
                                <Border Background="{DynamicResource CardBrush}"
                                       BorderBrush="{DynamicResource BorderBrush}"
                                       BorderThickness="1"
                                       CornerRadius="8" 
                                       Padding="20" 
                                       Margin="0,0,0,20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Service Icon -->
                                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                               Background="{DynamicResource PrimaryBrush}"
                                               CornerRadius="8"
                                               Width="60" Height="60"
                                               Margin="0,0,16,0"
                                               VerticalAlignment="Center">
                                            <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"
                                                 Fill="White"
                                                 Width="24" Height="24"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Service Name -->
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                  Text="{Binding Service.Name}"
                                                  FontSize="18"
                                                  FontWeight="SemiBold"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  Margin="0,0,0,8"/>

                                        <!-- Executable Path -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                            <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                                 Fill="{DynamicResource TextSecondaryBrush}"
                                                 Width="14" Height="14"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Service.Path}"
                                                      FontSize="12"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <!-- Status -->
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" 
                                                   Fill="{Binding Service.Status, Converter={StaticResource StringStatusToColorConverter}}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Service.Status}"
                                                      FontSize="12"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                      VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Configuration Files Button -->
                                        <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                               Style="{StaticResource ModernSecondaryButton}"
                                               VerticalAlignment="Center"
                                               Command="{Binding OpenConfigurationFilesCommand}"
                                               Width="180"
                                               Cursor="Hand"
                                               Height="40"
                                               Margin="16,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📁" 
                                                          FontSize="16"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Text="Configuration Files" 
                                                          FontSize="12"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Configuration Settings -->
                                <Border Background="{DynamicResource CardBrush}"
                                       BorderBrush="{DynamicResource BorderBrush}"
                                       BorderThickness="1"
                                       CornerRadius="8" 
                                       Padding="20" 
                                       Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Configuration Settings" 
                                                  FontSize="16"
                                                  FontWeight="SemiBold" 
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  Margin="0,0,0,16"/>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Port -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" 
                                                      Text="Port:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center" 
                                                      Margin="0,0,0,12"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" 
                                                    Text="{Binding Configuration.Port, UpdateSourceTrigger=PropertyChanged}" 
                                                    Style="{StaticResource ModernTextBox}"
                                                    Margin="0,0,0,12"/>

                                            <!-- Version -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" 
                                                      Text="Version:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center" 
                                                      Margin="0,0,0,12"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" 
                                                    Text="{Binding Configuration.Version, UpdateSourceTrigger=PropertyChanged}" 
                                                    Style="{StaticResource ModernTextBox}"
                                                    Margin="0,0,0,12"/>

                                            <!-- Path -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" 
                                                      Text="Path:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center" 
                                                      Margin="0,0,0,12"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" 
                                                    Text="{Binding Configuration.Path, UpdateSourceTrigger=PropertyChanged}" 
                                                    Style="{StaticResource ModernTextBox}"
                                                    Margin="0,0,0,12"/>

                                            <!-- Auto Start -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" 
                                                      Text="Auto Start:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center" 
                                                      Margin="0,0,0,0"/>
                                            <CheckBox Grid.Row="3" Grid.Column="1" 
                                                     IsChecked="{Binding Configuration.AutoStart, UpdateSourceTrigger=PropertyChanged}" 
                                                     Style="{StaticResource ModernToggleSwitch}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Advanced Configuration -->
                                <Border Background="{DynamicResource CardBrush}"
                                       BorderBrush="{DynamicResource BorderBrush}"
                                       BorderThickness="1"
                                       CornerRadius="8" 
                                       Padding="20"
                                       Visibility="{Binding IsPHPService, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="PHP Configuration" 
                                                  FontSize="16"
                                                  FontWeight="SemiBold" 
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  Margin="0,0,0,16"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- display_errors -->
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                      Text="display_errors:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,0,12"/>
                                            <CheckBox Grid.Row="0" Grid.Column="1"
                                                     IsChecked="{Binding DisplayErrors, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernToggleSwitch}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,0,12"/>

                                            <!-- file_uploads -->
                                            <TextBlock Grid.Row="1" Grid.Column="0"
                                                      Text="file_uploads:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,0,12"/>
                                            <CheckBox Grid.Row="1" Grid.Column="1"
                                                     IsChecked="{Binding FileUploads, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernToggleSwitch}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,0,12"/>

                                            <!-- allow_url_fopen -->
                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                      Text="allow_url_fopen:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,0,12"/>
                                            <CheckBox Grid.Row="2" Grid.Column="1"
                                                     IsChecked="{Binding AllowUrlFopen, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernToggleSwitch}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,0,12"/>

                                            <!-- allow_url_include -->
                                            <TextBlock Grid.Row="3" Grid.Column="0"
                                                      Text="allow_url_include:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,0,12"/>
                                            <CheckBox Grid.Row="3" Grid.Column="1"
                                                     IsChecked="{Binding AllowUrlInclude, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource ModernToggleSwitch}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,0,12"/>

                                            <!-- memory_limit -->
                                            <TextBlock Grid.Row="4" Grid.Column="0"
                                                      Text="memory_limit:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,0,12"/>
                                            <TextBox Grid.Row="4" Grid.Column="1"
                                                    Text="{Binding MemoryLimit, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource ModernTextBox}"
                                                    Margin="0,0,0,12"/>

                                            <!-- max_execution_time -->
                                            <TextBlock Grid.Row="5" Grid.Column="0"
                                                      Text="max_execution_time:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,0,12"/>
                                            <TextBox Grid.Row="5" Grid.Column="1"
                                                    Text="{Binding MaxExecutionTime, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource ModernTextBox}"
                                                    Margin="0,0,0,12"/>

                                            <!-- upload_max_filesize -->
                                            <TextBlock Grid.Row="6" Grid.Column="0"
                                                      Text="upload_max_filesize:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,0,12"/>
                                            <TextBox Grid.Row="6" Grid.Column="1"
                                                    Text="{Binding UploadMaxFilesize, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource ModernTextBox}"
                                                    Margin="0,0,0,12"/>

                                            <!-- post_max_size -->
                                            <TextBlock Grid.Row="7" Grid.Column="0"
                                                      Text="post_max_size:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,0,12"/>
                                            <TextBox Grid.Row="7" Grid.Column="1"
                                                    Text="{Binding PostMaxSize, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource ModernTextBox}"
                                                    Margin="0,0,0,12"/>

                                            <!-- max_input_time -->
                                            <TextBlock Grid.Row="8" Grid.Column="0"
                                                      Text="max_input_time:"
                                                      FontSize="14"
                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,0,0"/>
                                            <TextBox Grid.Row="8" Grid.Column="1"
                                                    Text="{Binding MaxInputTime, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource ModernTextBox}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PHP Extensions Tab (only shown for PHP services) -->
                    <TabItem Visibility="{Binding ShowExtensionsTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TabItem.Header>
                            <TextBlock Text="PHP Extensions" 
                                      FontSize="14" 
                                      FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Filters Section -->
                            <Border Grid.Row="0" 
                                   Background="{DynamicResource CardBrush}" 
                                   BorderBrush="{DynamicResource BorderBrush}"
                                   BorderThickness="0,0,0,1"
                                   Padding="24,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search -->
                                    <TextBox Grid.Column="0"
                                            Style="{StaticResource SearchBox}"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Text="{Binding PhpExtensionSearchText, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Category Filter -->
                                    <ComboBox Grid.Column="1"
                                             Style="{StaticResource ModernComboBox}"
                                             Height="40"
                                             Margin="0,0,12,0"
                                             ItemsSource="{Binding PhpExtensionCategories}"
                                             SelectedItem="{Binding PhpExtensionCategoryFilter}"
                                           MinWidth="140"/>

                                    <!-- Status Filter -->
                                    <ComboBox Grid.Column="2"
                                             Style="{StaticResource ModernComboBox}"
                                             Height="40"
                                             Margin="0,0,12,0"
                                             ItemsSource="{Binding PhpExtensionStatusOptions}"
                                             SelectedItem="{Binding PhpExtensionStatusFilter}"
                                           MinWidth="140"/>

                                    <!-- Refresh Button -->
                                    <Button Grid.Column="3"
                                           Content="Refresh"
                                           Style="{StaticResource ModernSecondaryButton}"
                                           Command="{Binding RefreshPhpExtensionsCommand}"
                                           Height="40"
                                           Padding="16,8"
                                           MinWidth="140"
                                           Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Extensions List -->
                            <ScrollViewer Grid.Row="1"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource ModernScrollViewer}">
                                <StackPanel Margin="24">
                                    <ItemsControl ItemsSource="{Binding FilteredPhpExtensions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBrush}"
                                                       BorderBrush="{DynamicResource BorderBrush}"
                                                       BorderThickness="1"
                                                       CornerRadius="8"
                                                       Margin="0,0,0,12"
                                                       Padding="16">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Name}" 
                                                                      FontSize="16" 
                                                                      FontWeight="SemiBold" 
                                                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                                                      Margin="0,0,0,8"/>
                                                            <TextBlock Text="{Binding Description}" 
                                                                      FontSize="12" 
                                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                                      TextWrapping="Wrap"
                                                                      Margin="0,0,0,8"/>
                                                            <TextBlock Text="{Binding Category}" 
                                                                      FontSize="11" 
                                                                      Foreground="{DynamicResource AccentBrush}"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                               Content="{Binding ToggleButtonText}"
                                                               Command="{Binding DataContext.TogglePhpExtensionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               MinWidth="100"
                                                               Padding="16,10"
                                                               MinHeight="36"
                                                               VerticalAlignment="Center">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Cursor" Value="No"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Cursor" Value="Hand"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Loading Overlay for PHP Extensions -->
                            <Grid Grid.Row="1" 
                                  Background="{DynamicResource BackgroundBrush}"
                                  Visibility="{Binding PhpExtensionsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Opacity="0.95"
                                  Panel.ZIndex="100">
                                <StackPanel HorizontalAlignment="Center" 
                                           VerticalAlignment="Center">
                                    <Border Width="48" Height="48" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,20">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="4"/>
                                                <Setter Property="CornerRadius" Value="24"/>
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                               From="0" To="360" Duration="0:0:1"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.RenderTransform>
                                            <RotateTransform CenterX="24" CenterY="24"/>
                                        </Border.RenderTransform>
                                        <Ellipse Width="8" Height="8" 
                                                Fill="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="2"/>
                                    </Border>
                                    
                                    <TextBlock Text="{Binding StatusMessage}"
                                              FontSize="16"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Apache Modules Tab (only shown for Apache services) -->
                    <TabItem Visibility="{Binding ShowModulesTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TabItem.Header>
                            <TextBlock Text="Apache Modules" 
                                      FontSize="14" 
                                      FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Filters Section -->
                            <Border Grid.Row="0" 
                                   Background="{DynamicResource CardBrush}" 
                                   BorderBrush="{DynamicResource BorderBrush}"
                                   BorderThickness="0,0,0,1"
                                   Padding="24,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search -->
                                    <TextBox Grid.Column="0"
                                            Style="{StaticResource SearchBox}"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Text="{Binding ApacheModuleSearchText, UpdateSourceTrigger=PropertyChanged}"/>

                                    <!-- Category Filter -->
                                    <ComboBox Grid.Column="1"
                                             Style="{StaticResource ModernComboBox}"
                                             Height="40"
                                             Margin="0,0,12,0"
                                             ItemsSource="{Binding ApacheModuleCategories}"
                                             SelectedItem="{Binding ApacheModuleCategoryFilter}"
                                            MinWidth="140"/>

                                    <!-- Status Filter -->
                                    <ComboBox Grid.Column="2"
                                             Style="{StaticResource ModernComboBox}"
                                             Height="40"
                                             Margin="0,0,12,0"
                                             ItemsSource="{Binding ApacheModuleStatusOptions}"
                                             SelectedItem="{Binding ApacheModuleStatusFilter}"
                                            MinWidth="140"/>

                                    <!-- Synchronize Button -->
                                    <Button Grid.Column="3"
                                           Content="Synchronize"
                                           Style="{StaticResource ModernSecondaryButton}"
                                           Command="{Binding SynchronizeApacheModulesCommand}"
                                           Height="40"
                                           Padding="16,8"
                                           MinWidth="140"
                                           Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Modules List -->
                            <ScrollViewer Grid.Row="1"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource ModernScrollViewer}">
                                <StackPanel Margin="24">
                                    <ItemsControl ItemsSource="{Binding FilteredApacheModules}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBrush}"
                                                       BorderBrush="{DynamicResource BorderBrush}"
                                                       BorderThickness="1"
                                                       CornerRadius="8"
                                                       Margin="0,0,0,12"
                                                       Padding="16">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal" 
                                                                       Margin="0,0,0,8"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" 
                                                                          FontSize="16" 
                                                                          FontWeight="SemiBold" 
                                                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                                                          VerticalAlignment="Center"/>
                                                                
                                                                <!-- Enabled Badge -->
                                                                <Border Background="{DynamicResource AccentBrush}" 
                                                                       CornerRadius="12" 
                                                                       Padding="8,4" 
                                                                       Margin="12,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="ENABLED" 
                                                                              FontSize="10" 
                                                                              FontWeight="Bold" 
                                                                              Foreground="White"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Disabled Badge -->
                                                                <Border Background="{DynamicResource SurfaceBrush}" 
                                                                       CornerRadius="12" 
                                                                       Padding="8,2" 
                                                                       Margin="12,0,0,0"
                                                                       Visibility="{Binding IsEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="DISABLED" 
                                                                              FontSize="10" 
                                                                              FontWeight="Bold" 
                                                                              Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                </Border>
                                                            </StackPanel>

                                                            <TextBlock Text="{Binding ModuleName}" 
                                                                      FontSize="12" 
                                                                      Foreground="{DynamicResource AccentBrush}"
                                                                      Margin="0,0,0,8"/>
                                                            
                                                            <TextBlock Text="{Binding Description}" 
                                                                      FontSize="12" 
                                                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                                                      TextWrapping="Wrap"
                                                                      Margin="0,0,0,8"/>

                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="File: " FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                               Content="{Binding ToggleButtonText}"
                                                               Command="{Binding DataContext.ToggleApacheModuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               MinWidth="100"
                                                               Padding="16,10"
                                                               MinHeight="36"
                                                               VerticalAlignment="Center"
                                                               IsEnabled="{Binding CanToggle}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ModernSecondaryButton}">
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False">
                                                                            <Setter Property="Cursor" Value="No"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Cursor" Value="Hand"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Pagination Controls -->
                            <Border Grid.Row="2"
                                   Background="{DynamicResource CardBrush}"
                                   BorderBrush="{DynamicResource BorderBrush}"
                                   BorderThickness="0,1,0,0"
                                   Padding="24,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Pagination Info -->
                                    <TextBlock Grid.Column="0"
                                              Text="{Binding ApacheModulePaginationInfo}"
                                              FontSize="12"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              VerticalAlignment="Center"/>

                                    <!-- Pagination Buttons -->
                                    <StackPanel Grid.Column="1"
                                               Orientation="Horizontal"
                                               HorizontalAlignment="Right">
                                        <Button Content="Previous"
                                               Command="{Binding ApacheModulePreviousPageCommand}"
                                               Style="{StaticResource ModernSecondaryButton}"
                                               MinWidth="100"
                                               Height="36"
                                               Padding="16,8"
                                               Margin="0,0,8,0"
                                               Cursor="Hand"
                                               IsEnabled="{Binding CanGoToPreviousPage}"/>
                                        <Button Content="Next"
                                               Command="{Binding ApacheModuleNextPageCommand}"
                                               Style="{StaticResource ModernSecondaryButton}"
                                               MinWidth="100"
                                               Height="36"
                                               Padding="16,8"
                                               Cursor="Hand"
                                               IsEnabled="{Binding CanGoToNextPage}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Loading Overlay for Apache Modules -->
                            <Grid Grid.Row="1" Grid.RowSpan="2" 
                                  Background="{DynamicResource BackgroundBrush}"
                                  Visibility="{Binding ApacheModulesLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  Opacity="0.95"
                                  Panel.ZIndex="100">
                                <StackPanel HorizontalAlignment="Center" 
                                           VerticalAlignment="Center">
                                    <Border Width="48" Height="48" 
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,20">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter Property="BorderThickness" Value="4"/>
                                                <Setter Property="CornerRadius" Value="24"/>
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                               From="0" To="360" Duration="0:0:1"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.RenderTransform>
                                            <RotateTransform CenterX="24" CenterY="24"/>
                                        </Border.RenderTransform>
                                        <Ellipse Width="8" Height="8" 
                                                Fill="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="2"/>
                                    </Border>
                                    
                                    <TextBlock Text="{Binding StatusMessage}"
                                              FontSize="16"
                                              FontWeight="SemiBold"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            
            <!-- Configuration Content (shown when TabControl is hidden - single tab services) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Disabled"
                         Style="{StaticResource ModernScrollViewer}"
                         Visibility="{Binding ShowTabControl, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel Margin="24">
                    <!-- Service Information Card -->
                    <Border Background="{DynamicResource CardBrush}"
                           BorderBrush="{DynamicResource BorderBrush}"
                           BorderThickness="1"
                           CornerRadius="8" 
                           Padding="20" 
                           Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Service Icon -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                   Background="{DynamicResource PrimaryBrush}"
                                   CornerRadius="8"
                                   Width="60" Height="60"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"
                                     Fill="White"
                                     Width="24" Height="24"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                            </Border>

                            <!-- Service Name -->
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                      Text="{Binding Service.Name}"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,0,0,8"/>

                            <!-- Executable Path -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                     Fill="{DynamicResource TextSecondaryBrush}"
                                     Width="14" Height="14"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Service.Path}"
                                          FontSize="12"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" 
                                       Fill="{Binding Service.Status, Converter={StaticResource StringStatusToColorConverter}}"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Service.Status}"
                                          FontSize="12"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Configuration Files Button -->
                            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                   Style="{StaticResource ModernSecondaryButton}"
                                   VerticalAlignment="Center"
                                   Command="{Binding OpenConfigurationFilesCommand}"
                                   Width="180"
                                   Cursor="Hand"
                                   Height="40"
                                   Margin="16,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" 
                                              FontSize="16"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Text="Configuration Files" 
                                              FontSize="12"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Configuration Settings -->
                    <Border Background="{DynamicResource CardBrush}"
                           BorderBrush="{DynamicResource BorderBrush}"
                           BorderThickness="1"
                           CornerRadius="8" 
                           Padding="20" 
                           Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Configuration Settings" 
                                      FontSize="16"
                                      FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Port -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                          Text="Port:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center" 
                                          Margin="0,0,0,12"/>
                                <TextBox Grid.Row="0" Grid.Column="1" 
                                        Text="{Binding Configuration.Port, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,12"/>

                                <!-- Version -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                          Text="Version:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center" 
                                          Margin="0,0,0,12"/>
                                <TextBox Grid.Row="1" Grid.Column="1" 
                                        Text="{Binding Configuration.Version, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,12"/>

                                <!-- Path -->
                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                          Text="Path:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center" 
                                          Margin="0,0,0,12"/>
                                <TextBox Grid.Row="2" Grid.Column="1" 
                                        Text="{Binding Configuration.Path, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,12"/>

                                <!-- Auto Start -->
                                <TextBlock Grid.Row="3" Grid.Column="0" 
                                          Text="Auto Start:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center" 
                                          Margin="0,0,0,0"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" 
                                         IsChecked="{Binding Configuration.AutoStart, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernToggleSwitch}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Advanced Configuration -->
                    <Border Background="{DynamicResource CardBrush}"
                           BorderBrush="{DynamicResource BorderBrush}"
                           BorderThickness="1"
                           CornerRadius="8" 
                           Padding="20"
                           Visibility="{Binding IsPHPService, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="PHP Configuration" 
                                      FontSize="16"
                                      FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- display_errors -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                          Text="display_errors:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,12"/>
                                <CheckBox Grid.Row="0" Grid.Column="1"
                                         IsChecked="{Binding DisplayErrors, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernToggleSwitch}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,0,12"/>

                                <!-- file_uploads -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                          Text="file_uploads:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,12"/>
                                <CheckBox Grid.Row="1" Grid.Column="1"
                                         IsChecked="{Binding FileUploads, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernToggleSwitch}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,0,12"/>

                                <!-- allow_url_fopen -->
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                          Text="allow_url_fopen:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,12"/>
                                <CheckBox Grid.Row="2" Grid.Column="1"
                                         IsChecked="{Binding AllowUrlFopen, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernToggleSwitch}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,0,12"/>

                                <!-- allow_url_include -->
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                          Text="allow_url_include:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,12"/>
                                <CheckBox Grid.Row="3" Grid.Column="1"
                                         IsChecked="{Binding AllowUrlInclude, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernToggleSwitch}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,0,12"/>

                                <!-- memory_limit -->
                                <TextBlock Grid.Row="4" Grid.Column="0"
                                          Text="memory_limit:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,12"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                        Text="{Binding MemoryLimit, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,12"/>

                                <!-- max_execution_time -->
                                <TextBlock Grid.Row="5" Grid.Column="0"
                                          Text="max_execution_time:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,12"/>
                                <TextBox Grid.Row="5" Grid.Column="1"
                                        Text="{Binding MaxExecutionTime, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,12"/>

                                <!-- upload_max_filesize -->
                                <TextBlock Grid.Row="6" Grid.Column="0"
                                          Text="upload_max_filesize:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,12"/>
                                <TextBox Grid.Row="6" Grid.Column="1"
                                        Text="{Binding UploadMaxFilesize, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,12"/>

                                <!-- post_max_size -->
                                <TextBlock Grid.Row="7" Grid.Column="0"
                                          Text="post_max_size:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,12"/>
                                <TextBox Grid.Row="7" Grid.Column="1"
                                        Text="{Binding PostMaxSize, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,12"/>

                                <!-- max_input_time -->
                                <TextBlock Grid.Row="8" Grid.Column="0"
                                          Text="max_input_time:"
                                          FontSize="14"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,0,0"/>
                                <TextBox Grid.Row="8" Grid.Column="1"
                                        Text="{Binding MaxInputTime, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ModernTextBox}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Action Buttons -->
        <Border Grid.Row="2" 
               Background="{DynamicResource CardBrush}"
               BorderBrush="{DynamicResource BorderBrush}"
               BorderThickness="1"
               CornerRadius="8"
               Padding="20"
               Margin="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Status Message -->
                    <TextBlock Grid.Column="0"
                              Text="{Binding StatusMessage}"
                              FontSize="12"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" 
                               HorizontalAlignment="Right">
                        <Button Content="Cancel" 
                               Style="{StaticResource ModernSecondaryButton}"
                               Command="{Binding CancelCommand}"
                               Margin="0,0,12,0"
                               Padding="16,8"
                               MinWidth="80"
                               Cursor="Hand"/>
                                
                        <Button Command="{Binding SaveCommand}"
                               Padding="16,8"
                               MinWidth="140"
                               IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernPrimaryButton}">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Cursor" Value="No"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Loading Spinner -->
                                <Grid Width="16" Height="16" 
                                      Margin="0,0,8,0"
                                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!-- Modern Ring Spinner -->
                                    <Ellipse Stroke="{DynamicResource PrimaryButtonTextBrush}" 
                                            StrokeThickness="2" 
                                            Width="14" Height="14"
                                            StrokeDashArray="10,5"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="SaveButtonSpinnerRotation"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="SaveButtonSpinnerRotation"
                                                                       Storyboard.TargetProperty="Angle"
                                                                       From="0" To="360" Duration="0:0:0.8"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                </Grid>
                                
                                <!-- Icon (hidden when loading) -->
                                <TextBlock Text="💾" 
                                          FontSize="16" 
                                          Margin="0,0,8,0" 
                                          VerticalAlignment="Center"
                                          Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                
                                <!-- Button Text -->
                                <TextBlock Text="Save Changes" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
       </Border>
    </Grid>
</UserControl>

