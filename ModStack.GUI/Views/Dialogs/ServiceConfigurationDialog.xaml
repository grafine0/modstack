<Window x:Class="ModStack.GUI.Views.Dialogs.StackServiceConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service Configuration" 
        Height="680" 
        Width="780"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <!-- Dialog container with enhanced shadow -->
    
    <Border CornerRadius="8"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Style="{StaticResource DialogTitleBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Title -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Service Configuration" 
                                Style="{StaticResource DialogTitleTextStyle}"/>
                        <TextBlock Text="{Binding Service.Name}" 
                                Style="{StaticResource DialogSubtitleTextStyle}"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="1" 
                            Style="{StaticResource DialogCloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" 
                            VerticalScrollBarVisibility="Auto" 
                            HorizontalScrollBarVisibility="Disabled"
                            Margin="20,0"
                            Style="{StaticResource ModernScrollViewer}">
                <StackPanel Margin="0,20,0,0">
                    
                    <!-- Service Information Card -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20" 
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Service Icon -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="8"
                                    Width="60" Height="60"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"
                                        Fill="{DynamicResource TextPrimaryBrush}"
                                        Width="24" Height="24"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                            </Border>

                            <!-- Service Name -->
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                        Text="{Binding Service.Name}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,8"/>

                            <!-- Executable Path -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"
                                        Fill="{DynamicResource TextSecondaryBrush}"
                                        Width="14" Height="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Service.Path}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" 
                                            Fill="{Binding Service.Status, Converter={StaticResource StringStatusToColorConverter}}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Service.Status}"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Configuration Files Button -->
                            <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                                    Style="{StaticResource ModernSecondaryButton}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Width="180"
                                    Height="40"
                                    Margin="16,0,0,0"
                                    Click="ConfigurationFilesButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📁" 
                                               FontSize="16"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="Configuration Files" 
                                               FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </Grid>
                    </Border>

                    <!-- Configuration Settings -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20" 
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Configuration Settings" 
                                        FontSize="16"
                                        FontWeight="SemiBold" 
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Port -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                            Text="Port:"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            VerticalAlignment="Center" 
                                            Margin="0,0,0,12"/>
                                <TextBox Grid.Row="0" Grid.Column="1" 
                                        Text="{Binding Configuration.Port, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,12"/>

                                <!-- Version -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                            Text="Version:"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            VerticalAlignment="Center" 
                                            Margin="0,0,0,12"/>
                                <TextBox Grid.Row="1" Grid.Column="1" 
                                        Text="{Binding Configuration.Version, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,12"/>

                                <!-- Path -->
                                <TextBlock Grid.Row="2" Grid.Column="0" 
                                            Text="Path:"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            VerticalAlignment="Center" 
                                            Margin="0,0,0,12"/>
                                <TextBox Grid.Row="2" Grid.Column="1" 
                                        Text="{Binding Configuration.Path, UpdateSourceTrigger=PropertyChanged}" 
                                        Style="{StaticResource ModernTextBox}"
                                        Margin="0,0,0,12"/>

                                <!-- Auto Start -->
                                <TextBlock Grid.Row="3" Grid.Column="0" 
                                            Text="Auto Start:"
                                            FontSize="14"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            VerticalAlignment="Center" 
                                            Margin="0,0,0,0"/>
                                <CheckBox Grid.Row="3" Grid.Column="1" 
                                            IsChecked="{Binding Configuration.AutoStart, UpdateSourceTrigger=PropertyChanged}" 
                                            Style="{StaticResource ModernToggleSwitch}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Advanced Configuration -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Advanced Configuration" 
                                        FontSize="16"
                                        FontWeight="SemiBold" 
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,12"/>

                            <TextBlock Text="Configuration overrides (JSON format):" 
                                        FontSize="12" 
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Margin="0,0,0,8"/>

                            <TextBox Text="{Binding ConfigurationJson}" 
                                    Style="{StaticResource ModernTextBox}"
                                    Height="200" 
                                    TextWrapping="Wrap" 
                                    AcceptsReturn="True"
                                    VerticalScrollBarVisibility="Auto"
                                    FontFamily="Consolas"
                                    FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="Cancel" 
                            Style="{StaticResource ModernSecondaryButton}"
                            Click="CancelButton_Click"
                            Margin="0,0,12,0"
                            Padding="16,8"
                            MinWidth="80"/>
                            
                    <Button Name="SaveButton"
                           Style="{StaticResource ModernPrimaryButton}"
                           Width="140"
                           Height="40"
                           Margin="0,0,12,0"
                           Grid.Column="2"
                           Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="💾" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Save Changes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>