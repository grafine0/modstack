<Window x:Class="ModStack.GUI.Views.Dialogs.ServiceDeletionConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Service Deletion" 
        Height="450" 
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <!-- Modern dialog container with shadow -->
    <Border CornerRadius="12"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource CardBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Warning Icon -->
                    <Border Grid.Column="0" 
                            Width="32" Height="32" 
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="16"
                            Margin="0,0,16,0">
                        <TextBlock Text="⚠️" 
                                  FontSize="16" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                    </Border>
                    
                    <!-- Title -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Confirm Service Deletion" 
                                  FontSize="18" 
                                  FontWeight="SemiBold" 
                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="This action requires confirmation" 
                                  FontSize="12" 
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="2" 
                            Style="{StaticResource TitleBarButton}"
                            Width="24" Height="24"
                            Click="CloseButton_Click"
                            ToolTip="Cancel">
                        <TextBlock Text="✕" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         Padding="24,20">
                <StackPanel>
                    <!-- Main Question -->
                    <TextBlock Text="{Binding MainMessage}" 
                              FontSize="16" 
                              FontWeight="Medium" 
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              TextWrapping="Wrap"
                              Margin="0,0,0,20"/>

                    <!-- Service Information -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Service:" FontWeight="SemiBold" Margin="0,0,12,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServiceDisplayName}" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Type:" FontWeight="SemiBold" Margin="0,0,12,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServiceType}" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Version:" FontWeight="SemiBold" Margin="0,0,12,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ServiceVersion}" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Port:" FontWeight="SemiBold" Margin="0,0,12,8" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ServicePort}" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Status:" FontWeight="SemiBold" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ServiceStatus}" Margin="0,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Grid>
                    </Border>

                    <!-- File Deletion Option -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox x:Name="DeleteFilesCheckBox"
                                     IsChecked="{Binding DeleteFiles, Mode=TwoWay}"
                                     Content="Also delete service files from disk"
                                     FontSize="14"
                                     FontWeight="Medium"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,12"/>
                            
                            <TextBlock Text="{Binding FilesDeletionMessage}"
                                      FontSize="12"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      TextWrapping="Wrap"
                                      Margin="24,0,0,0"
                                      Visibility="{Binding DeleteFiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Warnings Section -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="⚠️" FontSize="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Important Warnings" 
                                          FontSize="14" 
                                          FontWeight="SemiBold" 
                                          Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>
                            
                            <ItemsControl ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="•" 
                                                      FontSize="12" 
                                                      Foreground="{DynamicResource TextSecondaryBrush}" 
                                                      Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding}" 
                                                      FontSize="12" 
                                                      Foreground="{DynamicResource TextSecondaryBrush}" 
                                                      TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Action Summary -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Summary of Actions" 
                                      FontSize="14" 
                                      FontWeight="SemiBold" 
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding ActionSummary}" 
                                      FontSize="13" 
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="24,16">
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right">
                     <Button Content="Cancel" 
                            Style="{StaticResource ModernSecondaryButton}"
                            Width="100" 
                            Height="36"
                            Margin="0,0,12,0"
                            Click="CancelButton_Click"/>
                     <Button Content="Delete Service" 
                            Style="{StaticResource ModernDangerButton}"
                            Width="120" 
                            Height="36"
                            Click="DeleteButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
