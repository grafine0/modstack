<Window x:Class="ModStack.GUI.Views.Dialogs.PHPExtensionManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ModStack.GUI.Views.Dialogs"
        Title="PHP Extension Manager"
        Height="680" 
        Width="780"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Inverted Boolean to Visibility Converter -->
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        
        <!-- Extension Toggle Background Converter -->
        <local:ExtensionToggleBackgroundConverter x:Key="ExtensionToggleBackgroundConverter"/>
        
        <Style x:Key="ExtensionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        
        <!-- Extension Toggle Button Style -->
        <Style x:Key="ExtensionToggleButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource PrimaryFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{Binding IsEnabled, Converter={StaticResource ExtensionToggleBackgroundConverter}}"
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            Focusable="False"
                                            RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Dialog container with enhanced shadow -->
    <Border CornerRadius="8"
        Background="{DynamicResource CardBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Style="{StaticResource DialogTitleBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Title -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="PHP Extension Manager" 
                                Style="{StaticResource DialogTitleTextStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ServiceName}" 
                                    Style="{StaticResource DialogSubtitleTextStyle}"/>
                            <TextBlock Text=" v" 
                                    Style="{StaticResource DialogSubtitleTextStyle}"/>
                            <TextBlock Text="{Binding PHPVersion}" 
                                    Style="{StaticResource DialogSubtitleTextStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="1" 
                            Style="{StaticResource DialogCloseButtonStyle}"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Main Content -->
            <ScrollViewer Grid.Row="1" 
                            VerticalScrollBarVisibility="Auto" 
                            HorizontalScrollBarVisibility="Disabled"
                            Margin="20,0"
                            Style="{StaticResource ModernScrollViewer}">
                <StackPanel Margin="0,20,0,0">
                    
                    <!-- Service Information Card -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20" 
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- PHP Extension Icon -->
                            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="8"
                                    Width="60" Height="60"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="🧩" 
                                          FontSize="28"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <!-- Service Name -->
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                        Text="{Binding ServiceName}"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,8"/>

                            <!-- PHP Version Info -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M11,16.5L18,9.5L16.5,8L11,13.5L7.5,10L6,11.5L11,16.5Z"
                                        Fill="{DynamicResource TextSecondaryBrush}"
                                        Width="14" Height="14"
                                        Stretch="Uniform"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="PHP Version: "
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding PHPVersion}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>

                            <!-- Extension Count -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19Z"
                                        Fill="{DynamicResource TextSecondaryBrush}"
                                        Width="14" Height="14"
                                        Stretch="Uniform"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="Available Extensions: "
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding AvailableExtensions.Count}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text=" | Installed: "
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding InstalledExtensions.Count}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentBrush}"/>
                            </StackPanel>


                        </Grid>
                    </Border>

                    <!-- Filters Section -->
                    <Border Background="{DynamicResource CardBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16" 
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <!-- Modern Search Box -->
                            <TextBox x:Name="SearchTextBox" 
                                    Grid.Column="0"
                                    Style="{StaticResource SearchBox}"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    Height="40"
                                    Margin="0,0,12,0"/>

                            <!-- Category Filter -->
                            <ComboBox x:Name="CategoryComboBox"
                                    Grid.Column="1"
                                    Style="{StaticResource ModernComboBox}"
                                    ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding SelectedCategory}"
                                    Height="40"
                                    Margin="0,0,12,0"/>

                            <!-- Extension Type & Popular Filter Combined -->
                            <ComboBox x:Name="ExtensionFilterComboBox"
                                    Grid.Column="2"
                                    Style="{StaticResource ModernComboBox}"
                                    SelectedIndex="{Binding ExtensionFilterIndex}"
                                    Height="40">
                                <ComboBoxItem Content="All Extensions"/>
                                <ComboBoxItem Content="Available Extensions"/>
                                <ComboBoxItem Content="Installed Extensions"/>
                                <ComboBoxItem Content="Popular Extensions"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Extensions List Card -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8" 
                            Padding="20"
                            Name="ExtensionsListCard">
                        <StackPanel>
                            <TextBlock Name="ExtensionsListTitle"
                                        Text="Available Extensions" 
                                        FontSize="16"
                                        FontWeight="SemiBold" 
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        Margin="0,0,0,16"/>

                            <!-- Unified Extensions List -->
                            <ItemsControl Name="ExtensionsList"
                                          ItemsSource="{Binding FilteredExtensions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ExtensionCardStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Extension Info -->
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding DisplayName}" 
                                                                  FontSize="16" 
                                                                  FontWeight="SemiBold" 
                                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        
                                                        <!-- Installed Badge -->
                                                        <Border Background="#FF4CAF50" 
                                                               CornerRadius="12" 
                                                               Padding="8,2" 
                                                               Margin="12,0,0,0"
                                                               Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="INSTALLED" 
                                                                      FontSize="10" 
                                                                      FontWeight="Bold" 
                                                                      Foreground="White"/>
                                                        </Border>

                                                        <!-- Popular Badge -->
                                                        <Border Background="#FFFF9800" 
                                                               CornerRadius="12" 
                                                               Padding="8,2" 
                                                               Margin="8,0,0,0"
                                                               Visibility="{Binding IsPopular, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="POPULAR" 
                                                                      FontSize="10" 
                                                                      FontWeight="Bold" 
                                                                      Foreground="White"/>
                                                        </Border>

                                                        <!-- Built-in Badge -->
                                                        <Border Background="#FF2196F3" 
                                                               CornerRadius="12" 
                                                               Padding="8,2" 
                                                               Margin="8,0,0,0"
                                                               Visibility="{Binding IsBuiltIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="BUILT-IN" 
                                                                      FontSize="10" 
                                                                      FontWeight="Bold" 
                                                                      Foreground="White"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Description}" 
                                                              FontSize="12" 
                                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                                              TextWrapping="Wrap"
                                                              Margin="0,0,0,8"/>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Category: " FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Category}" FontSize="11" Margin="0,0,16,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="Type: " FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding ExtensionType}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Install Button (for not installed extensions) -->
                                                    <Button Content="Install" 
                                                           Style="{StaticResource ModernPrimaryButton}"
                                                           Command="{Binding DataContext.InstallExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                           Width="80" Height="32"
                                                           Margin="0,0,8,0"/>
                                                    
                                                    <!-- Enable/Disable Button (for installed extensions) -->
                                                    <Button Content="{Binding ToggleButtonText}"
                                                           Style="{StaticResource ExtensionToggleButtonStyle}"
                                                           Command="{Binding DataContext.ToggleExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Width="80" Height="32"
                                                           Margin="0,0,8,0"/>
                                                    
                                                    <!-- Remove Button (for installed extensions) -->
                                                    <Button Content="Remove" 
                                                           Style="{StaticResource ModernDangerButton}"
                                                           Command="{Binding DataContext.UninstallExtensionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Width="80" Height="32"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="20,16">
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="Refresh Extensions" 
                            Style="{StaticResource ModernSecondaryButton}"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,12,0"
                            Padding="16,8"
                            MinWidth="140"/>
                            
                    <Button Content="Close"
                           Style="{StaticResource ModernPrimaryButton}"
                           Click="CloseButton_Click"
                           Padding="16,8"
                           MinWidth="80"/>
                </StackPanel>
            </Border>

            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="3" 
                  Background="{DynamicResource BackgroundBrush}"
                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Opacity="0.95">
                <StackPanel HorizontalAlignment="Center" 
                           VerticalAlignment="Center">
                    
                    <!-- Animated Loading Spinner -->
                    <Border Width="48" Height="48" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="CornerRadius" Value="24"/>
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                               From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <RotateTransform CenterX="24" CenterY="24"/>
                        </Border.RenderTransform>
                        <Ellipse Width="8" Height="8" 
                                 Fill="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="2"/>
                    </Border>
                    
                    <!-- Loading Text -->
                    <TextBlock Text="{Binding LoadingMessage}"
                              FontSize="16"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,8"/>
                              
                    <TextBlock Text="Please wait while we scan and organize PHP extensions..."
                              FontSize="12"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              MaxWidth="300"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
