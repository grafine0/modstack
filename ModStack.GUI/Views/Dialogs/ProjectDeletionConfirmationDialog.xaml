<Window x:Class="ModStack.GUI.Views.Dialogs.ProjectDeletionConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Project Deletion" 
        Height="500" 
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    
    <!-- Modern dialog container with shadow -->
    <Border CornerRadius="12"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              ShadowDepth="8"
                              BlurRadius="16"
                              Opacity="0.3"
                              Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource CardBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Warning Icon -->
                    <TextBlock Grid.Column="0"
                              Text="⚠️"
                              FontSize="20"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"/>
                    
                    <!-- Title -->
                    <TextBlock Grid.Column="1"
                              Text="Confirm Project Deletion"
                              FontSize="16"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              VerticalAlignment="Center"/>
                    
                    <!-- Close Button -->
                    <Button Grid.Column="2"
                           Content="✖"
                           Style="{StaticResource CloseButton}"
                           Width="24"
                           Height="24"
                           Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="24,16">
                <StackPanel>
                    <!-- Main Warning Message -->
                    <TextBlock Text="{Binding MainMessage}"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              TextWrapping="Wrap"
                              Margin="0,0,0,16"/>
                    
                    <!-- Project Information Section -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📋 Project Information"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource AccentBrush}"
                                      Margin="0,0,0,8"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProjectName}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Path:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProjectPath}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Stack:" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StackName}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- File Deletion Option -->
                    <Border Background="{DynamicResource CardBrush}"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <CheckBox x:Name="DeleteFilesCheckBox"
                                     Content="Also delete project files and configuration"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     IsChecked="{Binding DeleteFiles, Mode=TwoWay}"
                                     Margin="0,0,0,8"/>
                            
                            <TextBlock Text="{Binding FilesDeletionMessage}"
                                      FontSize="12"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      TextWrapping="Wrap"
                                      Margin="24,0,0,8"/>
                            
                            <TextBlock Text="{Binding ServiceRestartMessage}"
                                      FontSize="12"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      TextWrapping="Wrap"
                                      Margin="24,0,0,0"
                                      Visibility="{Binding DeleteFiles, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Warnings Section -->
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="⚠️ Important Warnings"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource AccentBrush}"
                                      Margin="0,0,0,8"/>
                            
                            <ItemsControl ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                  FontSize="12"
                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                  TextWrapping="Wrap"
                                                  Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Button Area -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource CardBrush}"
                    CornerRadius="0,0,12,12"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Action Summary -->
                    <TextBlock Grid.Column="0"
                              Text="{Binding ActionSummary}"
                              FontSize="11"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    
                    <!-- Cancel Button -->
                    <Button Grid.Column="1"
                           Content="Cancel"
                           Style="{StaticResource ModernSecondaryButton}"
                           Width="100"
                           Height="36"
                           Margin="0,0,12,0"
                           Click="CancelButton_Click"/>
                    
                    <!-- Delete Button -->
                    <Button Grid.Column="2"
                           Content="Delete Project"
                           Style="{StaticResource ModernDangerButton}"
                           Width="120"
                           Height="36"
                           Click="DeleteButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
