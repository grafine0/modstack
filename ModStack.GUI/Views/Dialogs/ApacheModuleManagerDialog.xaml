<Window x:Class="ModStack.GUI.Views.Dialogs.ApacheModuleManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ModStack.GUI.Converters"
        Title="Apache Module Manager"
        Height="680" 
        Width="780"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        
        <!-- Module Toggle Background Converter -->
        <converters:ModuleToggleBackgroundConverter x:Key="ModuleToggleBackgroundConverter"/>
        
        <!-- Module Toggle Text Converter -->
        <converters:ModuleToggleTextConverter x:Key="ModuleToggleTextConverter"/>
        
        <!-- Module Toggle Button Style -->
        <Style x:Key="ModuleToggleButtonStyle" TargetType="Button">
            <Setter Property="FontFamily" Value="{DynamicResource PrimaryFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{Binding IsEnabled, Converter={StaticResource ModuleToggleBackgroundConverter}}"
                                CornerRadius="6"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="contentPresenter"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}"
                                            Focusable="False"
                                            RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12,12,0,0" Padding="24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Apache Module Manager" 
                                  FontSize="24" 
                                  FontWeight="Bold" 
                                  Foreground="{DynamicResource TextPrimaryBrush}" 
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Enable or disable Apache modules to customize your web server functionality"
                                  FontSize="14" 
                                  Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" 
                            Style="{StaticResource TitleBarButton}" 
                            Width="32" Height="32"
                            Command="{Binding CloseCommand}">
                        <TextBlock Text="✕" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Filter Section -->
            <Border Grid.Row="1" Background="{DynamicResource CardBrush}" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBox Grid.Column="0"
                            Name="SearchTextBox"
                            Style="{StaticResource SearchBox}"
                            Height="40"
                            Margin="0,0,12,0"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Category Filter -->
                    <ComboBox Grid.Column="1"
                             Name="CategoryFilterComboBox"
                             Style="{StaticResource ModernComboBox}"
                             Height="40"
                             Margin="0,0,12,0"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding CategoryFilter}"/>

                    <!-- Status Filter -->
                    <ComboBox Grid.Column="2"
                             Name="StatusFilterComboBox"
                             Style="{StaticResource ModernComboBox}"
                             Height="40"
                             Margin="0,0,12,0"
                             ItemsSource="{Binding StatusOptions}"
                             SelectedItem="{Binding StatusFilter}"/>
                </Grid>
            </Border>

            <!-- Modules List -->
            <Border Grid.Row="2" Background="{DynamicResource CardBrush}" Margin="0,1,0,0">
                <Grid>
                    <!-- Loading Overlay -->
                    <Border Name="LoadingOverlay" 
                           Background="{DynamicResource BackgroundBrush}"
                           Opacity="0.9"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Animated Loading Spinner -->
                            <Border Width="50" Height="50" 
                                   Background="Transparent"
                                   Margin="0,0,0,16">
                                <Border.RenderTransform>
                                    <RotateTransform x:Name="SpinnerRotation"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                               Storyboard.TargetProperty="Angle"
                                                               From="0" To="360"
                                                               Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <Ellipse Width="40" Height="40"
                                        Stroke="{DynamicResource AccentBrush}"
                                        StrokeThickness="4"
                                        StrokeDashArray="31.416 31.416"
                                        StrokeDashOffset="31.416"
                                        StrokeStartLineCap="Round"
                                        StrokeEndLineCap="Round"/>
                            </Border>
                            <TextBlock Name="LoadingMessageText"
                                      Text="{Binding LoadingMessage}"
                                      FontSize="16"
                                      FontWeight="Medium"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Content -->
                    <ScrollViewer Name="ContentScrollViewer" 
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 Style="{StaticResource ModernScrollViewer}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel Margin="24">
                            <!-- Modules List -->
                            <ItemsControl Name="ModulesItemsControl" 
                                         ItemsSource="{Binding FilteredModules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBrush}"
                                               BorderBrush="{DynamicResource BorderBrush}"
                                               BorderThickness="1"
                                               CornerRadius="8"
                                               Margin="0,0,0,12"
                                               Padding="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Module Info -->
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding Name}" 
                                                                  FontSize="16" 
                                                                  FontWeight="SemiBold" 
                                                                  Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        
                                                        <!-- Enabled Badge -->
                                                        <Border Background="{DynamicResource AccentBrush}" 
                                                               CornerRadius="12" 
                                                               Padding="8,2" 
                                                               Margin="12,0,0,0"
                                                               Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="ENABLED" 
                                                                      FontSize="10" 
                                                                      FontWeight="Bold" 
                                                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        </Border>

                                                        <!-- Disabled Badge -->
                                                        <Border Background="{DynamicResource SurfaceBrush}" 
                                                               CornerRadius="12" 
                                                               Padding="8,2" 
                                                               Margin="12,0,0,0"
                                                               Visibility="{Binding IsEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                            <TextBlock Text="DISABLED" 
                                                                      FontSize="10" 
                                                                      FontWeight="Bold" 
                                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>

                                                        <!-- Category Badge -->
                                                        <Border Background="{DynamicResource SurfaceBrush}" 
                                                               CornerRadius="12" 
                                                               Padding="8,2" 
                                                               Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Category}" 
                                                                      FontSize="10" 
                                                                      FontWeight="Bold" 
                                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding ModuleName}" 
                                                              FontSize="12" 
                                                              Foreground="{DynamicResource AccentBrush}"
                                                              Margin="0,0,0,8"/>
                                                    
                                                    <TextBlock Text="{Binding Description}" 
                                                              FontSize="12" 
                                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                                              TextWrapping="Wrap"
                                                              Margin="0,0,0,8"/>

                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="File: " FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{Binding ToggleButtonText}"
                                                           Background="{Binding IsEnabled, Converter={StaticResource ModuleToggleBackgroundConverter}}"
                                                           Style="{StaticResource ModuleToggleButtonStyle}"
                                                           Width="80" Height="32"
                                                           Margin="0,0,8,0"
                                                           Command="{Binding DataContext.ToggleModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           CommandParameter="{Binding}"
                                                           IsEnabled="{Binding CanToggle}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <Border Grid.Row="3" 
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Status Message -->
                    <TextBlock Grid.Column="0"
                              Name="StatusTextBlock"
                              Text="{Binding StatusMessage}"
                              FontSize="12"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" 
                                HorizontalAlignment="Right">
                        <Button Content="Synchronize" 
                                Style="{StaticResource ModernSecondaryButton}"
                                Command="{Binding SynchronizeCommand}"
                                Margin="0,0,12,0"
                                Padding="16,8"
                                MinWidth="140"/>
                                
                        <Button Content="Close"
                               Style="{StaticResource ModernPrimaryButton}"
                               Command="{Binding CloseCommand}"
                               Padding="16,8"
                               MinWidth="80"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Loading Overlay -->
            <Grid Grid.RowSpan="4" 
                  Background="{DynamicResource BackgroundBrush}"
                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Opacity="0.95">
                <StackPanel HorizontalAlignment="Center" 
                           VerticalAlignment="Center">
                    
                    <!-- Animated Loading Spinner -->
                    <Border Width="48" Height="48" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,20">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="CornerRadius" Value="24"/>
                                <Style.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                               From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.RenderTransform>
                            <RotateTransform CenterX="24" CenterY="24"/>
                        </Border.RenderTransform>
                        <Ellipse Width="8" Height="8" 
                                 Fill="{DynamicResource AccentBrush}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Margin="2"/>
                    </Border>
                    
                    <!-- Loading Text -->
                    <TextBlock Text="{Binding LoadingMessage}"
                              FontSize="16"
                              FontWeight="SemiBold"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,8"/>
                              
                    <TextBlock Text="Please wait while we scan and organize PHP extensions..."
                              FontSize="12"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              MaxWidth="300"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
