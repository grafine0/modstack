<Window x:Class="ModStack.GUI.Views.Dialogs.ServiceSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Service to Add" 
        Height="500" 
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <!-- Outer shadow -->
    <Border CornerRadius="8"
            Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              Opacity="0.25"
                              BlurRadius="15"
                              ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Style="{StaticResource DialogTitleBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" 
                              Text="Select a service to add to the stack" 
                              Style="{StaticResource DialogTitleTextStyle}"/>
                    
                    <Button Grid.Column="1" 
                            Style="{StaticResource DialogCloseButtonStyle}"
                            Click="CloseButton_Click"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Services List -->
            <ListBox Grid.Row="1" 
                    ItemsSource="{Binding AvailableServices}"
                    SelectedItem="{Binding SelectedService}"
                    Margin="20">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16" 
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Service Icon -->
                            <Ellipse Grid.Column="0" 
                                    Width="40" Height="40" 
                                    Fill="{Binding ServiceType, Converter={StaticResource ServiceTypeToColorConverter}}"
                                    Margin="0,0,16,0"/>

                            <!-- Service Info -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding DisplayName}" 
                                          FontWeight="Bold" 
                                          FontSize="16" 
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding ServiceType}" 
                                          FontSize="12" 
                                          Foreground="{DynamicResource TextSecondaryBrush}" 
                                          Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Version}" 
                                          FontSize="11" 
                                          Foreground="#999999" 
                                          Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Grid.Column="2" 
                                       VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" 
                                        Fill="{Binding IsInstalled, Converter={StaticResource BooleanToColorConverter}}"
                                        Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding IsInstalled, Converter={StaticResource BooleanToStatusConverter}}" 
                                          FontSize="11" 
                                          HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Right"
                       Margin="20,20,20,20">
                <Button Content="Cancel" 
                       Style="{StaticResource ModernPrimaryButton}"
                       Background="#9E9E9E"
                       Click="CancelButton_Click"
                       Margin="0,0,12,0"
                       Width="80"/>
                <Button Content="Add Service" 
                       Style="{StaticResource ModernPrimaryButton}"
                       Background="#4CAF50"
                       Click="AddButton_Click"
                       Width="100"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

