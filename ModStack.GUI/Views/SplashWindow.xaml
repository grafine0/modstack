<Window x:Class="ModStack.GUI.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Width="500" Height="350"
        Topmost="True">
    
    <Window.Resources>
        <!-- Modern shadow effect -->
        <DropShadowEffect x:Key="ModernShadow" 
                          Color="#000000" 
                          BlurRadius="20" 
                          ShadowDepth="5" 
                          Opacity="0.1"/>
        
        <!-- Dots animation storyboard -->
        <Storyboard x:Key="DotsAnimation" RepeatBehavior="Forever">
            <!-- Dot 1 Animation -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1Scale" 
                                         Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1Scale" 
                                         Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="1.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            
            <!-- Dot 2 Animation -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2Scale" 
                                         Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2Scale" 
                                         Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="1.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            
            <!-- Dot 3 Animation -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3Scale" 
                                         Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="1.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3Scale" 
                                         Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:1.0" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="1.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="1.0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="1.0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource DotsAnimation}"/>
        </EventTrigger>
    </Window.Triggers>
    
    <!-- Main content container with shadow -->
    <Border Background="{DynamicResource CardBrush}" 
            CornerRadius="12" 
            Margin="20" 
            Effect="{StaticResource ModernShadow}">
        
        <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Logo and title section -->
                <StackPanel Grid.Row="1" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20">
                    
                    <!-- Application icon/logo -->
                    <Image Width="80" Height="80" 
                           Source="pack://application:,,,/Resources/logo.png"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           Stretch="Uniform"/>
                    
                    <!-- Application name -->
                    <TextBlock Text="ModStack" 
                              FontSize="28" 
                              FontWeight="Bold" 
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,5"/>
                    
                    <!-- Subtitle -->
                    <TextBlock Text="Web Development Stack Manager" 
                              FontSize="14" 
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Loading text -->
                <TextBlock x:Name="LoadingTextBlock"
                          Grid.Row="2" 
                          Text="Initializing application..." 
                          FontSize="16" 
                          Foreground="{DynamicResource TextPrimaryBrush}" 
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20"/>
                
                <!-- Progress indicator -->
                <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,30">
                    <!-- Modern progress bar -->
                    <Border x:Name="ProgressBarContainer" 
                           Width="200" Height="4" 
                           Background="#E0E0E0" 
                           CornerRadius="2"
                           Margin="0,0,0,10">
                        <Border x:Name="ProgressBar"
                               Width="0" 
                               Height="4" 
                               Background="#0078D4" 
                               CornerRadius="2"
                               HorizontalAlignment="Left"/>
                    </Border>
                    
                    <!-- Loading dots animation -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="#0078D4" Margin="2">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Dot1Scale"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="#0078D4" Margin="2">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Dot2Scale"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="#0078D4" Margin="2">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Dot3Scale"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </StackPanel>
                </StackPanel>
        </Grid>
    </Border>
</Window>
