<UserControl x:Class="ModStack.GUI.Views.ConfigEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:converters="clr-namespace:ModStack.GUI.Converters"
             Background="{StaticResource BackgroundBrush}">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Modern Header -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20" 
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Config Editor" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Edit configuration files for your services" 
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              FontSize="14"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" 
                           Orientation="Horizontal" 
                           VerticalAlignment="Center">
                    <Button Name="SaveButton"
                           Style="{StaticResource ModernPrimaryButton}"
                           Width="140"
                           Height="40"
                           Margin="0,0,12,0"
                           Click="SaveButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Loading Spinner -->
                            <Grid Width="16" Height="16" 
                                  Margin="0,0,8,0"
                                  Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- Modern Ring Spinner -->
                                <Ellipse Stroke="{DynamicResource PrimaryButtonTextBrush}" 
                                        StrokeThickness="2" 
                                        Width="14" Height="14"
                                        StrokeDashArray="10,5"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SaveButtonSpinnerRotation"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="SaveButtonSpinnerRotation"
                                                                   Storyboard.TargetProperty="Angle"
                                                                   From="0" To="360" Duration="0:0:0.8"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>
                            
                            <!-- Icon (hidden when loading) -->
                            <TextBlock Text="💾" 
                                      Margin="0,0,8,0"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            
                            <!-- Button Text -->
                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="ReloadButton"
                           Style="{StaticResource ModernSecondaryButton}"
                           Width="140"
                           Height="40"
                           Click="ReloadButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,8,0"/>
                            <TextBlock Text="Reload"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- File Selection -->
        <Border Grid.Row="1" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20,16" 
                Margin="0,0,0,20">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- File Path Header -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        CornerRadius="8,8,0,0" 
                        Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                  Text="📄 Current File:" 
                                  FontWeight="Bold" 
                                  FontSize="14" 
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>

                        <TextBlock x:Name="CurrentFilePathTextBlock"
                                  Grid.Column="1" 
                                  Text="No file selected" 
                                  FontSize="14" 
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"/>

                        <Button x:Name="BrowseButton"
                                Grid.Column="2"
                                Style="{StaticResource ModernPrimaryButton}"
                                Width="120"
                                Height="40"
                                Click="BrowseButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁" Margin="0,0,8,0"/>
                                <TextBlock Text="Browse"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Editor Content -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Syntax Highlighting Options -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource CardBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="0,0,0,1" 
                            Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Syntax:" 
                                      FontWeight="Bold" 
                                      FontSize="12" 
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0"/>
                            
                            <ComboBox x:Name="SyntaxComboBox"
                                      Width="120"
                                      Style="{StaticResource ModernComboBox}"
                                      SelectionChanged="SyntaxComboBox_SelectionChanged">
                                <ComboBoxItem Content="Plain Text" Tag="text"/>
                                <ComboBoxItem Content="JSON" Tag="json"/>
                                <ComboBoxItem Content="XML" Tag="xml"/>
                                <ComboBoxItem Content="INI" Tag="ini"/>
                                <ComboBoxItem Content="YAML" Tag="yaml"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Text Editor -->
                    <Border Grid.Row="1" 
                            Padding="20">
                        <TextBox x:Name="ConfigTextBox" 
                                TextWrapping="NoWrap"
                                AcceptsReturn="True"
                                MinHeight="380"
                                AcceptsTab="True"
                                FontFamily="Consolas"
                                FontSize="12"
                                Style="{StaticResource ModernTextBox}"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto"
                                TextChanged="ConfigTextBox_TextChanged"/>
                    </Border>
                    
                </Grid>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1"
                CornerRadius="8" 
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusTextBlock" 
                          Text="Ready" 
                          Style="{StaticResource ModernCaptionText}"
                          VerticalAlignment="Center"/>

                <TextBlock x:Name="LineCountTextBlock" 
                          Grid.Column="1" 
                          Text="Lines: 0" 
                          Style="{StaticResource ModernCaptionText}"
                          VerticalAlignment="Center"
                          Margin="0,0,20,0"/>

                <TextBlock x:Name="CharCountTextBlock" 
                          Grid.Column="2" 
                          Text="Chars: 0" 
                          Style="{StaticResource ModernCaptionText}"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
