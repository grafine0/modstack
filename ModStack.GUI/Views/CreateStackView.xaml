<UserControl x:Class="ModStack.GUI.Views.CreateStackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Converters are defined globally in App.xaml -->
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Border Grid.Row="0" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="20" 
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding PageTitle}" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding PageSubtitle}"
                               FontSize="14" 
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                
                <Button Grid.Column="1"
                       Name="BackButton"
                       Style="{StaticResource ModernSecondaryButton}"
                       Height="32"
                       Click="BackButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="←" Margin="0,0,6,0" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Back to Stacks" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Basic Information -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Basic Information" 
                                  FontWeight="Bold" 
                                  FontSize="18" 
                                  Foreground="{DynamicResource TextPrimaryBrush}" 
                                  Margin="0,0,0,20"/>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                      Text="Stack Name:" 
                                      VerticalAlignment="Center" 
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Grid.Column="1" 
                                    Text="{Binding StackName, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModernTextBox}"
                                    Margin="12,0,0,0"
                                    ToolTip="Enter a unique name for this stack"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" 
                                      Text="Description:" 
                                      VerticalAlignment="Top" 
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,8,0,0"/>
                            <TextBox Grid.Column="1" 
                                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModernTextBox}"
                                    Height="60"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    VerticalScrollBarVisibility="Auto"
                                    Margin="12,0,0,0"
                                    ToolTip="Optional description for this stack"/>
                        </Grid>

                        <Grid Grid.Row="3" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Set as default stack&#x0a;when activated:"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Margin="0,0,10,0"
                                    TextWrapping="Wrap"/>
                            <CheckBox 
                                Grid.Column="1" 
                                Style="{StaticResource ModernToggleSwitch}" 
                                IsChecked="{Binding IsDefault}"
                                HorizontalAlignment="Left"
                                Margin="12,0,0,0"
                                FontSize="14"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Auto-start when stack&#x0a;is activated:"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Margin="0,0,10,0"
                                    TextWrapping="Wrap"/>
                            <CheckBox 
                                Grid.Column="1"
                                IsChecked="{Binding AutoStart}"
                                Style="{StaticResource ModernToggleSwitch}"
                                HorizontalAlignment="Left"
                                Margin="12,0,0,0"
                                FontSize="14"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Stack Templates -->
                <Border Grid.Row="1" 
                        Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0"
                                  Text="Quick Templates" 
                                  FontWeight="Bold" 
                                  FontSize="18" 
                                  Foreground="{DynamicResource TextPrimaryBrush}" 
                                  Margin="0,0,0,20"/>
                        
                        <WrapPanel Grid.Row="1" Orientation="Horizontal">
                            <Button Name="LAMPTemplateButton" 
                                   Style="{StaticResource ModernSecondaryButton}"
                                   Margin="0,0,12,12"
                                   Padding="20,12"
                                   Click="LAMPTemplateButton_Click"
                                   ToolTip="Apache + PHP + MySQL">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🦬" Margin="0,0,8,0" FontSize="16"/>
                                    <TextBlock Text="LAMP Stack"/>
                                </StackPanel>
                            </Button>
                            <Button Name="LEMPTemplateButton" 
                                   Style="{StaticResource ModernSecondaryButton}"
                                   Margin="0,0,12,12"
                                   Padding="20,12"
                                   Click="LEMPTemplateButton_Click"
                                   ToolTip="Nginx + PHP + MySQL">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🐘" Margin="0,0,8,0" FontSize="16"/>
                                    <TextBlock Text="LEMP Stack"/>
                                </StackPanel>
                            </Button>
                            <Button Name="DatabaseTemplateButton" 
                                   Style="{StaticResource ModernSecondaryButton}"
                                   Margin="0,0,12,12"
                                   Padding="20,12"
                                   Click="DatabaseTemplateButton_Click"
                                   ToolTip="MySQL + PostgreSQL + Redis">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗄️" Margin="0,0,8,0" FontSize="16"/>
                                    <TextBlock Text="Database Only"/>
                                </StackPanel>
                            </Button>
                            <Button Name="CustomTemplateButton" 
                                   Style="{StaticResource ModernSecondaryButton}"
                                   Margin="0,0,12,12"
                                   Padding="20,12"
                                   Click="CustomTemplateButton_Click"
                                   ToolTip="Select services manually">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" Margin="0,0,8,0" FontSize="16"/>
                                    <TextBlock Text="Custom Stack"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Services Selection -->
                <Border Grid.Row="2" 
                        Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="250"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" 
                                  Text="Services Selection"
                                  FontWeight="Bold"
                                  FontSize="18"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  Margin="0,0,0,16"/>

                        <!-- Modern Service Selection Cards -->
                        <ScrollViewer Grid.Row="1" 
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     Padding="0">
                            <ItemsControl Name="ServicesItemsControl" 
                                         ItemsSource="{Binding Services}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" 
                                                    Margin="0,0,0,0"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBrush}"
                                               BorderBrush="{DynamicResource BorderBrush}"
                                               BorderThickness="1"
                                               CornerRadius="8"
                                               Margin="8"
                                               Padding="16">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" 
                                                               Opacity="0.05" 
                                                               BlurRadius="8" 
                                                               ShadowDepth="2"/>
                                            </Border.Effect>
                                            
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                
                                                <!-- Service Header with Icon and Checkbox -->
                                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Service Icon -->
                                                    <Border Grid.Column="0"
                                                           Width="40" Height="40"
                                                           Background="{Binding ServiceType, Converter={StaticResource ServiceTypeToColorConverter}}"
                                                           CornerRadius="8"
                                                           Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding ServiceType, Converter={StaticResource ServiceTypeToIconConverter}}"
                                                                 FontSize="20"
                                                                 Foreground="White"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <!-- Service Name -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name, StringFormat={}{0:Title}}"
                                                                 FontWeight="SemiBold"
                                                                 FontSize="16"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding ServiceType}"
                                                                 FontSize="12"
                                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                                 Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Selection Checkbox -->
                                                    <CheckBox Grid.Column="2"
                                                            IsChecked="{Binding IsSelected}"
                                                            Style="{StaticResource ModernToggleSwitch}"
                                                            VerticalAlignment="Center"/>
                                                </Grid>
                                                
                                                <!-- Service Details -->
                                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Version" 
                                                                 FontSize="11" 
                                                                 Foreground="{DynamicResource TextSecondaryBrush}" 
                                                                 FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding Version}" 
                                                                 FontSize="14" 
                                                                 Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                 FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Port" 
                                                                 FontSize="11" 
                                                                 Foreground="{DynamicResource TextSecondaryBrush}" 
                                                                 FontWeight="Medium"/>
                                                        <TextBlock Text="{Binding Port}" 
                                                                 FontSize="14" 
                                                                 Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                 FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- Priority Badge -->
                                                <Border Grid.Row="2" 
                                                       Background="{Binding Priority, Converter={StaticResource PriorityToColorConverter}}"
                                                       CornerRadius="12"
                                                       HorizontalAlignment="Left"
                                                       Padding="8,4"
                                                       Margin="0,0,0,8">
                                                    <TextBlock Text="{Binding Priority, StringFormat=Priority {0}}"
                                                             FontSize="11"
                                                             FontWeight="Medium"
                                                             Foreground="White"/>
                                                </Border>
                                                
                                                <!-- Status Indicator -->
                                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                                                    <Ellipse Width="8" Height="8" 
                                                           Fill="{Binding IsSelected, Converter={StaticResource BooleanToStatusColorConverter}}"
                                                           Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding IsSelected, Converter={StaticResource BooleanToStatusTextConverter}}"
                                                             FontSize="12"
                                                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                
                                                <!-- Action Buttons -->
                                                <StackPanel Grid.Row="4" 
                                                           Orientation="Horizontal" 
                                                           HorizontalAlignment="Right">
                                                    <Button Style="{StaticResource ModernSecondaryButton}"
                                                           MinWidth="100" Height="34"
                                                           FontSize="12"
                                                           Margin="0,0,8,0"
                                                           Click="ConfigureService_Click"
                                                           Tag="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⚙" Margin="0,0,6,0" FontSize="12"/>
                                                            <TextBlock Text="Configure"/>
                                                        </StackPanel>
                                                    </Button>
                                                    
                                                    <Button Style="{StaticResource ModernSecondaryButton}"
                                                           MinWidth="80" Height="34"
                                                           FontSize="12"
                                                           Click="ViewServiceInfo_Click"
                                                           Tag="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="ℹ" Margin="0,0,6,0" FontSize="12"/>
                                                            <TextBlock Text="Info"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock Grid.Row="2" 
                                  Text="💡 Tip: Higher priority services start first"
                                  FontStyle="Italic"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  Margin="0,12,0,0"/>
                    </Grid>
                </Border>

                <!-- Port Configuration -->
                <Border Grid.Row="3" 
                        Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20" 
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Port Configuration" 
                                  Grid.Row="0"
                                  FontWeight="Bold" 
                                  FontSize="18" 
                                  Foreground="{DynamicResource TextPrimaryBrush}" 
                                  Margin="0,0,0,16"/>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Automatic port assignment:"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Margin="0,0,10,0"/>
                            <CheckBox 
                                Grid.Column="1"
                                IsChecked="{Binding AutoPortAssignment}"
                                Style="{StaticResource ModernToggleSwitch}"
                                HorizontalAlignment="Left"
                                Margin="12,0,0,0"
                                FontSize="14"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>

                        <TextBlock Text="Services will use their default ports. Conflicts will be resolved automatically."
                                  Grid.Row="2"
                                  FontStyle="Italic"
                                  Foreground="{DynamicResource TextSecondaryBrush}"
                                  FontSize="14"
                                  Margin="0,8,0,0"/>
                    </Grid>
                </Border>

                <!-- Advanced Options -->
                <Border Grid.Row="4" 
                        Background="{DynamicResource CardBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Advanced Options" 
                                  Grid.Row="0"
                                  FontWeight="Bold" 
                                  FontSize="18" 
                                  Foreground="{DynamicResource TextPrimaryBrush}" 
                                  Margin="0,0,0,16"/>
                        
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Create sample project for this stack:"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Margin="0,0,10,0"/>
                            <CheckBox 
                                Grid.Column="1"
                                IsChecked="{Binding CreateProject}"
                                Style="{StaticResource ModernToggleSwitch}"
                                HorizontalAlignment="Left"
                                Margin="12,0,0,0"
                                FontSize="14"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Enable detailed logging:"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Margin="0,0,10,0"/>
                            <CheckBox 
                                Grid.Column="1"
                                IsChecked="{Binding EnableLogging}"
                                Style="{StaticResource ModernToggleSwitch}"
                                HorizontalAlignment="Left"
                                Margin="12,0,0,0"
                                FontSize="14"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="Create configuration backup:"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    Margin="0,0,10,0"/>
                            <CheckBox 
                                Grid.Column="1"
                                IsChecked="{Binding CreateBackup}"
                                Style="{StaticResource ModernToggleSwitch}"
                                HorizontalAlignment="Left"
                                Margin="12,0,0,0"
                                FontSize="14"
                                Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" 
                Background="{DynamicResource CardBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1"
                CornerRadius="8" 
                Margin="0,20,0,0" 
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button Name="CancelButton"
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ModernSecondaryButton}"
                        Height="36"
                        Padding="24,8"
                        Click="CancelButton_Click">
                    <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                </Button>
                
                <Button Name="SaveButton"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Style="{StaticResource ModernPrimaryButton}"
                        Height="36"
                        Padding="24,8"
                        Command="{Binding CreateOrUpdateCommand}"
                        Click="SaveButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Loading Spinner -->
                        <Grid Width="16" Height="16" 
                              Margin="0,0,8,0"
                              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Modern Ring Spinner -->
                            <Ellipse Stroke="{DynamicResource PrimaryButtonTextBrush}" 
                                    StrokeThickness="2" 
                                    Width="14" Height="14"
                                    StrokeDashArray="10,5"
                                    RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SaveButtonSpinnerRotation"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="SaveButtonSpinnerRotation"
                                                               Storyboard.TargetProperty="Angle"
                                                               From="0" To="360" Duration="0:0:0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                        </Grid>
                        
                        <!-- Icon (hidden when loading) -->
                        <TextBlock Text="{Binding ButtonIcon}" 
                                  Margin="0,0,6,0" 
                                  FontSize="12" 
                                  VerticalAlignment="Center"
                                  Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        
                        <!-- Button Text -->
                        <TextBlock Text="{Binding ButtonText}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
